// Canoe connectivity and camera fragments.
	lenovo_bf: fragment@38 {
		target = <&tlmm>;
		__overlay__ {
			nfc {
				lenovo_ba: nfc_int_active {
					mux {
						function = "gpio";
						pins = "gpio75";
					};
					config {
						bias-pull-down;
						drive-strength = <0x2>;
						pins = "gpio75";
					};
				};
				lenovo_bc: nfc_int_suspend {
					mux {
						function = "gpio";
						pins = "gpio75";
					};
					config {
						bias-pull-down;
						drive-strength = <0x2>;
						pins = "gpio75";
					};
				};
				lenovo_bb: nfc_enable_active {
					mux {
						function = "gpio";
						pins = "gpio34", "gpio35";
					};
					config {
						bias-disable;
						drive-strength = <0x2>;
						pins = "gpio34", "gpio35";
					};
				};
				lenovo_bd: nfc_enable_suspend {
					mux {
						function = "gpio";
						pins = "gpio34", "gpio35";
					};
					config {
						bias-disable;
						drive-strength = <0x2>;
						pins = "gpio34", "gpio35";
					};
				};
			};
		};
	};
	lenovo_ce: fragment@42 {
		target = <&tlmm>;
		__overlay__ {
			cnss_pins {
				lenovo_c2: cnss_wlan_en_active {
					mux {
						function = "gpio";
						pins = "gpio16";
					};
					config {
						bias-pull-up;
						output-high;
						drive-strength = <0x10>;
						pins = "gpio16";
					};
				};
				lenovo_c3: cnss_wlan_en_sleep {
					mux {
						function = "gpio";
						pins = "gpio16";
					};
					config {
						bias-pull-down;
						output-low;
						drive-strength = <0x2>;
						pins = "gpio16";
					};
				};
				lenovo_c4: cnss_wlan_sw_ctrl {
					mux {
						function = "wcn_sw_ctrl";
						pins = "gpio18";
					};
				};
				lenovo_c5: cnss_wlan_sw_ctrl_wl_cx {
					mux {
						function = "wcn_sw";
						pins = "gpio19";
					};
				};
				lenovo_c6: cnss_host_sol_default {
					mux {
						function = "gpio";
						pins = "gpio204";
					};
					config {
						bias-pull-down;
						drive-strength = <0x4>;
						pins = "gpio204";
					};
				};
			};
		};
	};
	lenovo_cf: fragment@44 {
		target = <&reserved_memory>;
		__overlay__ {
			lenovo_c9: cnss_wlan_region {
				size = <0x0 0x2000000>;
				alignment = "", "", "", "", "", "@", "";
				reusable;
				alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
				compatible = "shared-dma-pool";
			};
		};
	};
	lenovo_d0: fragment@46 {
		target = <&soc>;
		__overlay__ {
			lenovo_cc: qcom,cnss-peach@b0000000 {
				wcal-pbs-supply = <&WCAL_PBS>;
				nvmem-cell-names = "xo_calib_reg";
				nvmem-cells = <&lenovo_4c>;
				wlan-txrx-intr-cpumask = <0x3 0x30>;
				qcom,pdc_mode_vote_table = " {class: wlan_pdc, ss: rf, res: L3K1.m, enable: 1}", " {class: wlan_pdc, ss: rf, res: L3K1.m, dwnval: 2}";
				qcom,pmu_vreg_map = "VDDD_AON_0P9", "S2J1", "VDDA_RFA_0P9", "S2J1", "VDDA_RFA_1P9", "S8F0", "VDDA_RFA_1P3", "S7F0", "VDDD_WLMX_0P9", "S2J1", "VDDD_WLCX_0P9", "S1J1", "VDDD_BTCX_0P9", "S2J1", "VDDD_BTCMX_0P9", "S2J1", "VDDA_PCIE_0P9", "S7F0", "VDDA_PCIE_1P2", "S7F0";
				qcom,vreg_pdc_map = "S1J1", "bb", "S2J1", "rf", "S7F0", "rf", "S8F0", "rf";
				qcom,bus-bw-cfg = <0x0 0x0 0x8ca 0x4b320 0x1d4c 0x4b320 0x7530 0x4b320 0x186a0 0x4b320 0x2ab98 0x30fb10 0x4c4b4 0x30fb10 0x8f6ec 0x626b50 0x1d4c 0x189110 0x0 0x0 0x8ca 0x216600 0x1d4c 0x216600 0x7530 0x216600 0x186a0 0x216600 0x2ab98 0x5eec00 0x4c4b4 0x7faf80 0x8f6ec 0xc35000 0x1d4c 0x216600>;
				qcom,bus-bw-cfg-count = <0x9>;
				qcom,icc-path-count = <0x2>;
				interconnect-names = "pcie_to_memnoc", "memnoc_to_ddr";
				interconnects = <&pcie_noc 0x35 &pcie_noc 0x232 &gem_noc 0x1e &mc_virt 0x200>;
				qcom,vdd-wlan-ant-share-config = <0x124f80 0x124f80 0x19 0x0 0x1>;
				vdd-wlan-ant-share-supply = <&L3K>;
				qcom,vdd-wlan-rfa2-config = <0x144380 0x147260 0x0 0x0 0x1>;
				vdd-wlan-rfa2-supply = <&S7F>;
				qcom,vdd-wlan-rfa1-config = <0x1ca020 0x1e8480 0x0 0x0 0x1>;
				vdd-wlan-rfa1-supply = <&S8F>;
				qcom,vdd-wlan-dig-config = <0xd9c60 0xf4240 0x0 0x0 0x1>;
				vdd-wlan-dig-supply = <&S2J>;
				qcom,vdd-wlan-cx-config = <0xd9c60 0xf4240 0x0 0x0 0x1>;
				vdd-wlan-cx-supply = <&S1J>;
				qcom,vdd-wlan-io12-config = <0x124f80 0x124f80 0x7530 0x0 0x1>;
				vdd-wlan-io12-supply = <&L3G>;
				qcom,vdd-wlan-aon-config = <0x1b7740 0x1b7740 0x7530 0x0 0x1>;
				vdd-wlan-aon-supply = <&L2G>;
				platform-name-required;
				msix-match-addr = "", "", "0";
				qcom,qmp = <&aoss_qmp>;
				qcom,same-dt-multi-dev;
				use-pm-domain;
				qcom,wlan-cbc-enabled;
				cnss-enable-self-recovery;
				qcom,wlan-ramdump-dynamic = "", "x", "";
				qcom,wlan-rc-num = "", "", "", "";
				qcom,wlan;
				pinctrl-4 = <&lenovo_c6>;
				pinctrl-3 = <&lenovo_c5>;
				pinctrl-2 = <&lenovo_c4>;
				pinctrl-1 = <&lenovo_c3>;
				pinctrl-0 = <&lenovo_c2>;
				pinctrl-names = "wlan_en_active", "wlan_en_sleep", "sw_ctrl", "sw_ctrl_wl_cx", "sol_default";
				mpm_wake_set_gpios = <0x12 0x13>;
				wlan-dev-sol-gpio = <&tlmm 0xcd 0x0>;
				wlan-host-sol-gpio = <&tlmm 0xcc 0x0>;
				qcom,sw-ctrl-gpio = <&tlmm 0x12 0x0>;
				qcom,bt-en-gpio = <&lenovo_7b 0x5 0x0>;
				wlan-en-gpio = <&tlmm 0x10 0x0>;
				supported-ids = <0x110e>;
				qcom,wlan-sw-ctrl-gpio = <&tlmm 0x13 0x0>;
				reg-names = "smmu_iova_ipa";
				reg = <0x0 0xb0000000 0x0 0x10000>;
				compatible = "qcom,cnss-peach";
			};
			lenovo_c8: qcom,cnss-direct-link {
				dma-coherent;
				memory-region = <&lenovo_c7>;
				qcom,iommu-group = <&cnss_audio_iommu_group0>;
				iommus = <&apps_smmu 0x100f 0x0>;
				#size-cells = <0x2>;
				#address-cells = <0x2>;
				compatible = "qcom,cnss-direct-link";
				lenovo_c7: direct_link_iommu_region_partition {
					iommu-addresses = <&lenovo_c8 0x0 0x0 0x0 0x18000000 &lenovo_c8 0x0 0xb0000000 0x0 0x50000000>;
				};
			};
			lenovo_cd: qcom,cnss-vendor-wlan-wonder {
				status = "okay";
				compatible = "qcom,cnss-vendor-wlan-wonder";
			};
		};
	};
	lenovo_d1: fragment@48 {
