	lenovo_d5: fragment@51 {
		target = <&soc>;
		__overlay__ {
			lenovo_d3: qcom,hfi-core {
				qcom,fw_image_name = "dcp.mbn";
				memory-region = <&dcp_mem>;
				qcom,pas-id = <0x3f>;
				qcom,device-map-addr-reg = <0x88000000 0x8000000>;
				reg-names = "swi_dev0";
				reg = <0x0 0x9cb1000 0x0 0x1000>;
				dma-coherent;
				iommus = <&apps_smmu 0x19a3 0x0>;
				qcom,smem-state-names = "stop", "ping", "wdog", "fatal";
				qcom,smem-states = <&dcp_smp2p_out 0x0 &dcp_smp2p_out 0x8 &dcp_smp2p_out 0xb &dcp_smp2p_out 0xc>;
				interrupt-names = "dcp_power_notify_irq", "dcp_event_notify_irq", "apss_power_notify_irq", "apss_event_notify_irq", "dcp_wdog_bus_error_irq", "smp2p_fatal_irq", "smp2p_err_service_ready_irq", "smp2p_dcp_clock_ready_irq", "smp2p_dcp_pong_irq", "smp2p_dcp_stop_ack_irq";
				interrupts-extended = <&ipcc_mproc 0xe 0x5 0x1 &ipcc_mproc 0xe 0x6 0x1 &ipcc_mproc 0x6 0x5 0x1 &ipcc_mproc 0x6 0x6 0x1 &intc 0x0 0x127 0x4 &dcp_smp2p_in 0x0 0x0 &dcp_smp2p_in 0x1 0x0 &dcp_smp2p_in 0x2 0x0 &dcp_smp2p_in 0x9 0x0 &dcp_smp2p_in 0x3 0x0>;
				mboxes = <&ipcc_mproc 0xe 0x5 &ipcc_mproc 0xe 0x6 &ipcc_mproc 0x6 0x5 &ipcc_mproc 0x6 0x6>;
				depends-on-supply = <&qcom_smp2p_dcp>;
				status = "ok";
				compatible = "qcom,msm-hfi-core";
			};
		};
	};
