			interrupts = <0x07 0x47 0x00 IRQ_TYPE_NONE 0x07 0x47 0x01 IRQ_TYPE_NONE 0x07 0x47 0x02 IRQ_TYPE_NONE>;
			interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
			qcom,pmic7-threshold;
