&tlmm {

	nfc {

		nfc_int_active: nfc_int_active {

			mux {
				function = "gpio";
				pins = "gpio75";
			};

			config {
				bias-pull-down;
				drive-strength = <0x02>;
				pins = "gpio75";
			};
		};

		nfc_int_suspend: nfc_int_suspend {

			mux {
				function = "gpio";
				pins = "gpio75";
			};

			config {
				bias-pull-down;
				drive-strength = <0x02>;
				pins = "gpio75";
			};
		};

		nfc_enable_active: nfc_enable_active {

			mux {
				function = "gpio";
				pins = "gpio34\0gpio35";
			};

			config {
				bias-disable;
				drive-strength = <0x02>;
				pins = "gpio34\0gpio35";
			};
		};

		nfc_enable_suspend: nfc_enable_suspend {

			mux {
				function = "gpio";
				pins = "gpio34\0gpio35";
			};

			config {
				bias-disable;
				drive-strength = <0x02>;
				pins = "gpio34\0gpio35";
			};
		};
	};
};

&qupv3_se21_i2c {
	#size-cells = <0x00>;
	#address-cells = <0x01>;
	qcom,clk-freq-out = <0xf4240>;
	status = "disabled";

	st21nfc: st21nfc@08 {
		pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend>;
		pinctrl-0 = <&nfc_int_active &nfc_enable_active>;
		pinctrl-names = "nfc_active\0nfc_suspend";
		interrupt-names = "nfc_irq";
		interrupts = <0x4b IRQ_TYPE_NONE>;
		nvmem-cell-names = "nfc_bob1_cell";
		nvmem-cells = <&bob1_off_mode_enable>;
		interrupt-parent = <&tlmm>;
		clkreq-gpios = <&tlmm 0x23 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&tlmm 0x22 GPIO_ACTIVE_HIGH>;
		irq-gpios = <&tlmm 0x4b GPIO_ACTIVE_HIGH>;
		reg = <0x08>;
		compatible = "st,st21nfc";
	};
};

