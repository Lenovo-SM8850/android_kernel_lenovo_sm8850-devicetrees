	bluetooth: wcn786x {
		qcom,pdc_init_table = "{class: wlan_pdc, ss: rf, res: S2J1.m, enable: 1}\0{class: wlan_pdc, ss: rf, res: S2J1.v, enable: 1}\0{class: wlan_pdc, ss: rf, res: S2J1.v, upval: 876}\0{class: wlan_pdc, ss: rf, res: S2J1.v, dwnval: 876}";
		qcom,bt-vdd-wlan-aon-config = <0xd9c60 0xf4240 0x00 0x00 0x01>;
		qcom,bt-vdd-wlan-aon-supply = <&S1J>;
		qcom,bt-vdd-rfa1p25-config = <0x144380 0x147260 0x00 0x01 0x00>;
		qcom,bt-vdd-rfa1p8-config = <0x1ca020 0x1e8480 0x00 0x01 0x00>;
		qcom,bt-vdd-rfa0p75-config = <0xd9c60 0xfcee0 0x00 0x01 0x00>;
		qcom,bt-vdd-dig-config = <0xd9c60 0xfcee0 0x00 0x01 0x01>;
		qcom,bt-vdd-aon-config = <0xd9c60 0xfcee0 0x00 0x01 0x00>;
		qcom,bt-ant-ldo-config = <0x1b7740 0x1c61a0 0x00 0x01 0x00>;
		qcom,bt-vdd12-io-config = <0x124f80 0x124f80 0x7530 0x01 0x01>;
		qcom,bt-vdd18-aon-config = <0x1b7740 0x1b7740 0x7530 0x01 0x01>;
		qcom,bt-vdd-rfa1p25-supply = <&S7F>;
		qcom,bt-vdd-rfa1p8-supply = <&S8F>;
		qcom,bt-vdd-rfa0p75-supply = <&S2J>;
		qcom,bt-vdd-aon-supply = <&S2J>;
		qcom,bt-vdd-dig-supply = <&S2J>;
		qcom,bt-ant-ldo-supply = <&L6K>;
		qcom,bt-vdd12-io-supply = <&L3G>;
		qcom,bt-vdd18-aon-supply = <&L2G>;
		qcom,qmp = <&aoss_qmp>;
		qcom,bt-reset-gpio = <&pmh0104_gpios 0x05 GPIO_ACTIVE_HIGH>;
		qcom,bt-fmd-clk-gpio = <&pmh0104_gpios 0x06 GPIO_ACTIVE_HIGH>;
		qcom,bt-sw-ctrl-gpio = <&tlmm 0x12 GPIO_ACTIVE_HIGH>;
		qcom,wl-reset-gpio = <&tlmm 0x10 GPIO_ACTIVE_HIGH>;
		mpm_wake_set_gpios = <0x12 0x09>;
		pinctrl-2 = <&bt_fmd_clk_en>;
		pinctrl-1 = <&cnss_bt_sw_ctrl>;
		pinctrl-0 = <&bt_en>;
		pinctrl-names = "bt_en\0sw_ctrl\0bt_fmd_clk_en";
		qcom,wcn786x;
		clock-names = "bt_rf_clk1";
		clocks = <&rpmhcc 0x06>;
		nvmem-cell-names = "fmd_set\0fmd_chg_pon\0fmd_cnt2_stop";
		nvmem-cells = <&fmd_set &fmd_chg_pon &fmd_cnt2_stop>;
		compatible = "qcom,wcn786x";
	};
};

