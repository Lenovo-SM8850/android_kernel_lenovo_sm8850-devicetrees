&soc {

	smmu_sde_iommu_region_partition1: smmu_sde_iommu_region_partition@1 {
		iommu-addresses = <&smmu_sde_unsec1 0x00 0x00 0x00 0x20000 &smmu_sde_unsec1 0x00 0xfc800000 0x00 0x2b00000 &smmu_sde_sec1 0x00 0x00 0x00 0x20000>;
	};

	smmu_sde_unsec1: qcom,smmu_sde_unsec_cb@1 {
		dma-coherent;
		qcom,iommu-earlymap;
		qcom,iommu-faults = "non-fatal";
		memory-region = <&smmu_sde_iommu_region_partition1>;
		iommus = <&apps_smmu 0x800 0x02>;
		compatible = "qcom,smmu_sde_unsec";
		status = "disabled";
		qcom,op-label = "hfi";
	};

	smmu_sde_sec1: qcom,smmu_sde_sec_cb@1 {
		qcom,iommu-vmid = <0x0a>;
		qcom,iommu-faults = "non-fatal";
		memory-region = <&smmu_sde_iommu_region_partition1>;
		iommus = <&apps_smmu 0x801 0x00>;
		compatible = "qcom,smmu_sde_sec";
		status = "disabled";
		qcom,op-label = "hfi";
	};
};

&soc {

