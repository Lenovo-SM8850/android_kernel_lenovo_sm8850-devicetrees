&spmi1_bus {

	qcom,pmd802x@4 {
		compatible = "qcom,spmi-pmic";
		reg = <0x04 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pmd802x";
		};

		pmd802x_tz: pmd802x-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x04 0x0a 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
		};

		pmd802x_gpios: pinctrl@8800 {
			compatible = "qcom,pmd802x-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;

			sde_disp0_vdd_active: sde_disp0_vdd_active {
				qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
				power-source = <0x02>;
				bias-disable;
				output-enable;
				input-disable;
				function = PMIC_GPIO_FUNC_NORMAL;
				pins = "gpio2";
			};
		};

		pmd802x_amoled_ecm: amoled-ecm@f900 {
			compatible = "qcom,amoled-ecm";
			reg = <0xf900>;
			interrupt-names = "ecm-sdam0\0ecm-sdam1\0ecm-sdam2";
			nvmem-names = "amoled-ecm-sdam0\0amoled-ecm-sdam1\0amoled-ecm-sdam2";
			nvmem = <&ecm_sdam_0 &ecm_sdam_1 &ecm_sdam_2>;
			interrupt-parent = <&spmi0_bus>;
			interrupts = <0x00 0xaa 0x01 IRQ_TYPE_EDGE_RISING 0x00 0xab 0x01 IRQ_TYPE_EDGE_RISING 0x00 0xac 0x01 IRQ_TYPE_EDGE_RISING>;
		};

		pmd802x_amoled: qcom-amoled {
			compatible = "qcom,amoled-regulator";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			nvmem-cells = <&ibb_spur_sqm_timer>;
			nvmem-cell-names = "ibb_spur_sqm_timer";
			status = "disabled";

			ibb_vreg: ibb@f800 {
				reg = <0xf800>;
				reg-names = "ibb_base";
				regulator-name = "ibb";
				regulator-min-microvolt = "\0\f5";
				regulator-max-microvolt = <0x895440>;
				regulator-allow-set-load;
				qcom,swire-control;
			};

			ab_vreg: elvdd@f900 {
				reg = <0xf900>;
				reg-names = "ab_base";
				regulator-name = "ab";
				regulator-min-microvolt = <0x2625a0>;
				regulator-max-microvolt = <0x53ec60>;
				qcom,swire-control;
			};

			oledb_vreg: oledb@fa00 {
				reg = <0xfa00>;
				reg-names = "oledb_base";
				regulator-name = "oledb";
				regulator-min-microvolt = <0x4c4b40>;
				regulator-max-microvolt = <0x7a1200>;
				qcom,swire-control;
			};
		};
	};

	qcom,pmih010x@7 {
		compatible = "qcom,spmi-pmic";
		reg = <0x07 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pmih010x";
		};

		pmih010x_tz: pmih010x-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x07 0x0a 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
			io-channels = <&pmk8850_vadc 0x2703>;
			io-channel-names = "thermal";
		};

		pmih010x_lite_tz: pmih010x-temp-alarm-lite@c00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xc00>;
			interrupts = <0x07 0x0c 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
			io-channels = <&pmk8850_vadc 0x2718>;
			io-channel-names = "thermal";
		};

		pmih010x_gpios: pinctrl@8800 {
			compatible = "qcom,pmih010x-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;

			ufs_therm {

				ufs_therm_default: ufs_therm_default {
					pins = "gpio15";
					bias-high-impedance;
				};
			};

			fcam_ntc {

				fcam_ntc_default: fcam_ntc_default {
					pins = "gpio18";
					bias-high-impedance;
				};
			};

			top_chg_therm {

				top_chg_therm_default: top_chg_therm_default {
					pins = "gpio12";
					bias-high-impedance;
				};
			};

			batt2_pack_therm {

				batt2_pack_therm_default: batt2_pack_therm_default {
					pins = "gpio16";
					bias-high-impedance;
				};
			};
		};

		pmih010x_eusb2_repeater: eusb2-repeater@fd00 {
			compatible = "qcom,pmic-eusb2-repeater";
			reg = <0xfd00>;
			vdd18-supply = <&pmh0101_l15>;
			vdd3-supply = <&pmh0101_l5>;
			qcom,param-override-seq = <0x02 0x54>;
		};

		pmih010x_haptics: qcom,hv-haptics@f000 {
			compatible = "qcom,hv-haptics";
			reg = <0xf000 0xf100 0xf200>;
			interrupts = <0x07 0xf0 0x01 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "fifo-empty";
			qcom,vmax-mv = <0x73a>;
			qcom,lra-period-us = <0x1e0c>;
			qcom,brake-mode = <0x01>;
			qcom,brake-pattern = [ff 3f 1f];
			qcom,drv-sig-shape = <0x01>;
			qcom,brake-sig-shape = <0x01>;
			qcom,rt-imp-detect;
			nvmem-names = "hap_cfg_sdam";
			nvmem = <&pmk8850_sdam_46>;

			hap_swr_slave_reg: qcom,hap-swr-slave-reg {
				regulator-name = "hap-swr-slave-reg";
			};

			effect_0 {
				qcom,effect-id = <0x00>;
				qcom,wf-vmax-mv = <0xe10>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = <0x7f7f7f7f>;
				qcom,wf-fifo-period = <0x00>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};

			effect_1 {
