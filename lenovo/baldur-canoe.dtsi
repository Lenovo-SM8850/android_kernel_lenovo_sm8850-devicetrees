			reg = <0x4900 0x100>;
			interrupts = <0x07 0x49 0x00 IRQ_TYPE_NONE 0x07 0x49 0x01 IRQ_TYPE_NONE 0x07 0x49 0x02 IRQ_TYPE_NONE>;
			interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
