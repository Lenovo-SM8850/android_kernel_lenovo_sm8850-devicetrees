		qcom,panel-te-source = <0x01>;
		qcom,platform-te-gpio = <&tlmm 0x57 GPIO_ACTIVE_HIGH>;
		qcom,dsi-phy = <&mdss_dsi_phy2 &mdss_dsi_phy3>;
		qcom,dsi-ctrl = <&mdss_dsi2 &mdss_dsi3>;
		status = "disabled";
		qcom,op-label = "hfi";
