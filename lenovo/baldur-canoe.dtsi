// SPDX-License-Identifier: GPL-2.0-only
#ifdef BALDUR_CANOE_BASE
#include "baldur-canoe-base.dtsi"
#else
// Mechanical conversion of the stock overlay; all references use labels.

&spmi0_bus {

	pmk8850@0 {
		compatible = "qcom,spmi-pmic";
		reg = <0x00 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pmk8850";
		};

		pmk8850_sdam_1: sdam@7000 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			ocp_log: ocp-log@76 {
				reg = <0x76 0x06>;
			};
		};

		pmk8850_sdam_2: sdam@7100 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7100>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			restart_reason: restart@48 {
				reg = <0x48 0x01>;
				bits = <0x01 0x07>;
			};

			bob1_off_mode_enable: bob1-off-mode-enable@50 {
				reg = <0x50 0x01>;
			};

			xo_calib_data: xo_calib-data@59 {
				reg = <0x59 0x01>;
			};

			alarm_log: alarm-log@76 {
				reg = <0x76 0x06>;
			};

			fmd_set: fmd-set@9a {
				reg = <0x9a 0x01>;
			};

			fmd_cont_after_pon: fmd_cont_after_pon@9c {
				reg = <0x9c 0x01>;
			};

			fmd_chg_pon: fmd-chg-pon@9f {
				reg = <0x9f 0x01>;
			};

			fmd_cnt2_stop: fmd-cnt2-stop@a2 {
				reg = <0xa2 0x01>;
			};
		};

		pmk8850_sdam_5: sdam@7400 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7400>;
		};

		pmk8850_sdam_6: sdam@7500 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7500>;
		};

		pmk8850_sdam_21: sdam@8400 {
			compatible = "qcom,spmi-sdam";
			reg = <0x8400>;
		};

		pmk8850_sdam_22: sdam@8500 {
			compatible = "qcom,spmi-sdam";
			reg = <0x8500>;
		};

		pmk8850_sdam_43: sdam@9a00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9a00>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			ibb_spur_sqm_timer: sqm-timer@b8 {
				reg = <0xb8 0x02>;
			};
		};

		pmk8850_sdam_46: sdam@9d00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9d00>;
		};

		ecm_sdam_0: pmk8850_sdam_59: sdam@aa00 {
			compatible = "qcom,spmi-sdam";
			reg = <0xaa00>;
		};

		ecm_sdam_1: pmk8850_sdam_60: sdam@ab00 {
			compatible = "qcom,spmi-sdam";
			reg = <0xab00>;
		};

		ecm_sdam_2: pmk8850_sdam_61: sdam@ac00 {
			compatible = "qcom,spmi-sdam";
			reg = <0xac00>;
		};

		pon_hlos@1300 {
			compatible = "qcom,pmk8350-pon";
			reg = <0x1300 0x800>;
			reg-names = "hlos\0pbs";

			pwrkey {
				compatible = "qcom,pmk8350-pwrkey";
				interrupts = <0x00 0x13 0x07 IRQ_TYPE_EDGE_BOTH>;
				linux,code = <0x74>;
			};

			resin {
				compatible = "qcom,pmk8350-resin";
				interrupts = <0x00 0x13 0x06 IRQ_TYPE_EDGE_BOTH>;
				linux,code = <0x72>;
			};
		};

		pmk8850_sdam_49: sdam@a000 {
			compatible = "qcom,spmi-sdam";
			reg = <0xa000>;
		};

		pmk8850_sdam_50: sdam@a100 {
			compatible = "qcom,spmi-sdam";
			reg = <0xa100>;
		};

		pmk8850_sdam_51: sdam@a200 {
			compatible = "qcom,spmi-sdam";
			reg = <0xa200>;
		};

		pmk8850_sdam_71: sdam@b600 {
			compatible = "qcom,spmi-sdam";
			reg = <0xb600>;

			usb_mode: usb-mode@50 {
				reg = <0x50 0x01>;
			};
		};

		pmk8850_sdam_72: sdam@b700 {
			compatible = "qcom,spmi-sdam";
			reg = <0xb700>;
		};

		pmk8850_gpios: pinctrl@b800 {
			compatible = "qcom,pmk8850-gpio";
			reg = <0xb800>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;

			lcd_bl_pwm_default: lcd-bl-pwm-default-state {
				pins = "gpio5";
				function = PMIC_GPIO_FUNC_FUNC3;
				input-disable;
				output-enable;
				power-source = <0x00>;
			};

			lcm_therm {

				lcm_therm_default: lcm_therm_default {
					pins = "gpio3";
					bias-high-impedance;
				};
			};

			cam_sensor_mclk0_1p8_active: cam_sensor_mclk0_1p8_active {
				power-source = <0x00>;
				output-enable;
				function = PMIC_GPIO_FUNC_FUNC2;
				pins = "gpio1";
			};

			cam_sensor_mclk0_1p8_suspend: cam_sensor_mclk0_1p8_suspend {
				bias-high-impedance;
				function = PMIC_GPIO_FUNC_FUNC2;
				pins = "gpio1";
			};

			cam_sensor_mclk1_1p8_active: cam_sensor_mclk1_1p8_active {
				power-source = <0x00>;
				output-enable;
				function = PMIC_GPIO_FUNC_FUNC2;
				pins = "gpio8";
			};

			cam_sensor_mclk1_1p8_suspend: cam_sensor_mclk1_1p8_suspend {
				bias-high-impedance;
				function = PMIC_GPIO_FUNC_FUNC2;
				pins = "gpio8";
			};
		};

		pmk8850_rtc: rtc@6100 {
			compatible = "qcom,pmk8350-rtc";
			reg = <0x6100 0x6200>;
			reg-names = "rtc\0alarm";
			interrupts = <0x00 0x62 0x01 IRQ_TYPE_EDGE_RISING>;
		};

		pmk8850-pwm {
			compatible = "qcom,pmk8850-pwm\0qcom,pmk8550-pwm";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			#pwm-cells = <0x02>;
		};

		pmk8850_vadc: vadc@9000 {
			compatible = "qcom,spmi-adc5-gen4";
			reg = <0x9000 0x9100>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x90 0x01 IRQ_TYPE_EDGE_RISING 0x00 0x91 0x01 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "adc-sdam0\0adc-sdam1";
			#thermal-sensor-cells = <0x01>;
			#io-channel-cells = <0x01>;
			io-channel-ranges;
			pinctrl-0 = <&pa_therm2_default>;
			pinctrl-names = "default";

			pmk8850_offset_ref {
				reg = <0x00>;
				label = "pmk8850_offset_ref";
			};

			pmk8850_vref_1p25 {
				reg = <0x01>;
				label = "pmk8850_vref_1p25";
			};

			pmk8850_die_temp {
				reg = <0x03>;
				label = "pmk8850_die_temp";
			};

			pmk8850_xo_therm {
				reg = <0x44>;
				label = "pmk8850_xo_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0101_offset_ref {
				reg = <0x100>;
				label = "pmh0101_offset_ref";
			};

			pmh0101_vref_1p25 {
				reg = <0x101>;
				label = "pmh0101_vref_1p25";
			};

			pmh0101_die_temp {
				reg = <0x103>;
				label = "pmh0101_die_temp";
			};

			pmh0101_vph_pwr {
				reg = <0x18e>;
				label = "pmh0101_vph_pwr";
			};

			qtm_therm: pmh0101_qtm_therm {
				reg = <0x14b>;
				label = "pmh0101_qtm_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0110_d_die_temp {
				reg = <0x303>;
				label = "pmh0110_d_die_temp";
			};

			pmh0110_d_vph_pwr {
				reg = <0x38e>;
				label = "pmh0110_d_vph_pwr";
			};

			pmh0110_f_die_temp {
				reg = <0x503>;
				label = "pmh0110_f_die_temp";
			};

			pmh0110_f_vph_pwr {
				reg = <0x58e>;
				label = "pmh0110_f_vph_pwr";
			};

			pmh0110_g_die_temp {
				reg = <0x603>;
				label = "pmh0110_g_die_temp";
			};

			pmh0110_g_vph_pwr {
				reg = <0x68e>;
				label = "pmh0110_g_vph_pwr";
			};

			pmh0110_i_die_temp {
				reg = <0x803>;
				label = "pmh0110_i_die_temp";
			};

			pmh0110_i_vph_pwr {
				reg = <0x88e>;
				label = "pmh0110_i_vph_pwr";
			};

			pmih010x_offset_ref {
				reg = <0x2700>;
				label = "pmih010x_offset_ref";
			};

			pmih010x_vref_1p25 {
				reg = <0x2701>;
				label = "pmih010x_vref_1p25";
			};

			pmih010x_die_temp {
				reg = <0x2703>;
				label = "pmih010x_die_temp";
			};

			pmih010x_vph_pwr {
				reg = <0x278e>;
				label = "pmih010x_vph_pwr";
			};

			pmih010x_vbat_sns_qbg {
				reg = <0x278f>;
				label = "pmih010x_vbat_sns_qbg";
			};

			pmih010x_iin {
				reg = <0x2717>;
				label = "pmih010x_iin";
			};

			pmih010x_ichg_fb {
				reg = <0x27a1>;
				label = "pmih010x_ichg_fb";
			};

			pmih010x_chg_temp {
				reg = <0x2710>;
				label = "pmih010x_chg_temp";
			};

			pmih010x_lite_die_temp {
				reg = <0x2718>;
				label = "pmih010x_lite_die_temp";
			};

			pmih010x_batt_therm {
				reg = <0x2744>;
				label = "pmih010x_batt_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmih010x_usb_therm {
				reg = <0x2747>;
				label = "pmih010x_usb_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmih010x_batt_therm2 {
				reg = <0x274c>;
				label = "pmih010x_batt_therm_2";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmih010x_wls_therm {
				reg = <0x274d>;
				label = "pmih010x_wls_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0101_skin_therm {
				reg = <0x144>;
				label = "pmh0101_skin_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0101_flash_led_ntc {
				reg = <0x145>;
				label = "pmh0101_flash_led_ntc";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0101_wlan_therm {
				reg = <0x146>;
				label = "pmh0101_wlan_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0101_usb2_conn_therm {
				reg = <0x148>;
				label = "pmh0101_usb2_conn_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0101_rear_cam_ntc {
				reg = <0x14a>;
				label = "pmh0101_rear_cam_ntc";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pmh0101_quiet_therm {
				reg = <0x14c>;
				label = "pmh0101_quiet_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
			};

			pmih010x_ufs_therm {
				reg = <0x274b>;
				label = "pmih010x_ufs_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
				qcom,adc5-gen4;
			};

			pmih010x_fcam_ntc {
				reg = <0x275e>;
				label = "pmih010x_fcam_ntc";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
				qcom,adc5-gen4;
			};

			pmk8850_lcm_therm {
				reg = <0x47>;
				label = "pmk8850_lcm_therm";
				qcom,ratiometric;
				qcom,pre-scaling = <0x01 0x01>;
				qcom,adc-tm-type = <0x01>;
				qcom,adc5-gen4;
			};
		};

		pmk8850_qpt: qcom,power-telemetry-device {
			compatible = "qcom,power-telemetry";
			status = "okay";
			interrupts = <0x00 0xa2 0x01 IRQ_TYPE_EDGE_RISING 0x00 0xa1 0x01 IRQ_TYPE_EDGE_RISING>;
			nvmem = <&pmk8850_sdam_49 &pmk8850_sdam_50 &pmk8850_sdam_51>;
			nvmem-names = "qpt-config-sdam\0qpt-frac-sdam\0qpt-data-sdam";
			#powerzone-cells = <0x01>;
			power-domains = <&CLUSTER_PD2>;
		};

		pmk8850_qvadj: qcom,voltage-adj-device {
			compatible = "qcom,vadj";
		};

		btl {
			compatible = "qcom,btl";
			nvmem = <&pmk8850_sdam_72>;
			nvmem-names = "btl-sdam";
		};

		qcom,power-telemetry-data-share-device {
			compatible = "qcom,power-telemetry-data-share";
		};
	};

	pmh0101@1 {
		compatible = "qcom,spmi-pmic";
		reg = <0x01 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pmh0101";
		};

		pmh0101_tz: pmh0101-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x01 0x0a 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
			io-channels = <&pmk8850_vadc 0x103>;
			io-channel-names = "thermal";
		};

		pmh0101_gpios: pinctrl@8800 {
			compatible = "qcom,pmh0101-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;

			qtm_therm_default: qtm-therm-default-state {
				pins = "gpio2";
				function = PMIC_GPIO_FUNC_NORMAL;
				bias-high-impedance;
			};

			pa_therm2_default: pa-therm2-default-state {
				pins = "gpio3";
				function = PMIC_GPIO_FUNC_NORMAL;
				bias-high-impedance;
			};

			cam-sensor-1p8-rst0-active-state {
				pins = "gpio4";
				function = PMIC_GPIO_FUNC_NORMAL;
				qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
				input-disable;
				output-enable;
				output-high;
				power-source = <0x00>;
				// Unreferenced stock phandle; this node has no exported symbol.
				phandle = <0x56>;
			};

			cam-sensor-1p8-rst0-suspend-state {
				pins = "gpio4";
				function = PMIC_GPIO_FUNC_NORMAL;
				qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
				input-disable;
				output-enable;
				output-low;
				// Unreferenced stock phandle; this node has no exported symbol.
				phandle = <0x57>;
			};

			pmh0101_bidir_lvl_shifter1_active: pmh0101-bidir-lvl-shifter1-state {
				pins = "gpio11\0gpio12";
				function = PMIC_GPIO_FUNC_NORMAL;
				bias-high-impedance;
			};

			pmh0101_bidir_lvl_shifter2_active: pmh0101-bidir-lvl-shifter2-state {
				pins = "gpio13\0gpio14";
				function = PMIC_GPIO_FUNC_NORMAL;
				bias-high-impedance;
			};

			pmh0101_bidir_lvl_shifter3_active: pmh0101-bidir-lvl-shifter3-state {
				pins = "gpio15\0gpio16";
				function = PMIC_GPIO_FUNC_NORMAL;
				bias-high-impedance;
			};

			pmh0101_bidir_lvl_shifter4_active: pmh0101-bidir-lvl-shifter4-state {
				pins = "gpio17\0gpio18";
				function = PMIC_GPIO_FUNC_NORMAL;
				bias-high-impedance;
			};

			rear_cam_ntc {

				rear_cam_ntc_default: rear_cam_ntc_default {
					pins = "gpio1";
					bias-high-impedance;
				};
			};

			quiet_therm {

				quiet_therm_default: quiet_therm_default {
					pins = "gpio9";
					bias-high-impedance;
				};
			};

			fast_chg_therm {

				fast_chg_therm_default: fast_chg_therm_default {
					pins = "gpio2";
					bias-high-impedance;
				};
			};

			bias_enp_active: bias_enp_active {
				power-source = <0x00>;
				output-high;
				output-enable;
				input-disable;
				qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
				function = PMIC_GPIO_FUNC_NORMAL;
				pins = "gpio11";
			};

			bias_enp_sleep: bias_enp_sleep {
				output-low;
				output-enable;
				input-disable;
				qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
				function = PMIC_GPIO_FUNC_NORMAL;
				pins = "gpio11";
			};

			bias_enn_active: bias_enn_active {
				power-source = <0x00>;
				output-high;
				output-enable;
				input-disable;
				qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
				function = PMIC_GPIO_FUNC_NORMAL;
				pins = "gpio10";
			};

			bias_enn_sleep: bias_enn_sleep {
				output-low;
				output-enable;
				input-disable;
				qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
				function = PMIC_GPIO_FUNC_NORMAL;
				pins = "gpio10";
			};
		};

		led_controller: led-controller {
			compatible = "qcom,pmh0101-pwm\0qcom,pm8350c-pwm";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			#pwm-cells = <0x02>;
			nvmem = <&pmk8850_sdam_21 &pmk8850_sdam_22>;
			nvmem-names = "lpg_chan_sdam\0lut_sdam";

			led@1 {
				reg = <0x01>;
				color = <0x01>;
				label = "red";
			};

			led@2 {
				reg = <0x02>;
				color = <0x02>;
				label = "green";
			};

			led@3 {
				reg = <0x03>;
				color = <0x03>;
				label = "blue";
			};
		};

		pmh0101_bcl: bcl@4700 {
			compatible = "qcom,pmh0101-bcl-v5";
			reg = <0x4700 0x100>;
			interrupts = <0x01 0x47 0x00 IRQ_TYPE_NONE 0x01 0x47 0x01 IRQ_TYPE_NONE 0x01 0x47 0x02 IRQ_TYPE_NONE>;
			interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
			qcom,pmic7-threshold;
			#thermal-sensor-cells = <0x01>;
		};

		pmh0101_flash: led-controller@ee00 {
			compatible = "qcom,pmh0101-flash-led\0qcom,spmi-flash-led";
			reg = <0xee00>;

			pmh0101_flash_led0: led-0 {
				function = "flash";
