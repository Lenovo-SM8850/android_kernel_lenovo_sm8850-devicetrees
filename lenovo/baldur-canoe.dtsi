	pmr735d_temp_alarm: pmr735d_tz {
		polling-delay-passive = <0x64>;
		thermal-sensors = <&pmr735d_tz>;

		trips {

			pmr735d_trip0: trip0 {
				temperature = <0x17318>;
				hysteresis = <0x00>;
				type = "passive";
			};

			pmr735d_trip1: trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x00>;
				type = "hot";
			};

			pmr735d_trip2: trip2 {
				temperature = <0x23668>;
				hysteresis = <0x00>;
				type = "critical";
			};
		};
	};

	pm8010m_temp_alarm: pm8010m_tz {
		polling-delay-passive = <0x64>;
		thermal-sensors = <&pm8010m_tz>;

		trips {

			pm8010m_trip0: trip0 {
				temperature = <0x17318>;
				hysteresis = <0x00>;
				type = "passive";
			};

			pm8010m_trip1: trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x00>;
				type = "hot";
			};

			pm8010m_trip2: trip2 {
				temperature = <0x23668>;
				hysteresis = <0x00>;
				type = "critical";
			};
		};
	};

	pm8010n_temp_alarm: pm8010n_tz {
		polling-delay-passive = <0x64>;
		thermal-sensors = <&pm8010n_tz>;

		trips {

			pm8010n_trip0: trip0 {
				temperature = <0x17318>;
				hysteresis = <0x00>;
				type = "passive";
			};

			pm8010n_trip1: trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x00>;
				type = "hot";
			};

			pm8010n_trip2: trip2 {
				temperature = <0x23668>;
				hysteresis = <0x00>;
				type = "critical";
			};
		};
	};

	vbat {
		polling-delay-passive = <0x00>;
		polling-delay = <0x00>;
		thermal-sensors = <&pmih010x_bcl 0x02>;

		trips {

			vbat_lvl0: vbat-lvl0 {
				temperature = <0xaf0>;
				hysteresis = <0x64>;
				type = "passive";
			};

			vbat_lvl1: vbat-lvl1 {
				temperature = <0xa28>;
				hysteresis = <0x64>;
				type = "passive";
			};

			vbat_lvl2: vbat-lvl2 {
				temperature = <0x8fc>;
				hysteresis = <0x64>;
				type = "passive";
			};
		};
	};
};

&soc {

	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default>;

		vol_up {
			label = "volume_up";
			gpios = <&tlmm 0x65 GPIO_ACTIVE_LOW>;
			linux,input-type = <0x01>;
			linux,code = <0x73>;
			gpio-key,wakeup;
			debounce-interval = <0x0f>;
			linux,can-disable;
		};
	};
};

&battery_charger {
	compatible = "lenovo,dual-bank-battery-charger-v1", "qcom,battery-charger";
	lenovo,usb1-burn-en-gpios = <&pmh0110_f_gpios 7 GPIO_ACTIVE_HIGH>;
	lenovo,usb2-burn-en-gpios = <&pmh0110_f_gpios 8 GPIO_ACTIVE_HIGH>;
	qcom,thermal-mitigation-step = <0x7a120>;
	qcom,thermal-mitigation = <0xbd3580 0xbd3580 0xb71b00 0xaf79e0 0xa7d8c0 0xa037a0 0x989680 0x90f560 0x895440 0x81b320 0x7a1200 0x6acfc0 0x5b8d80 0x4c4b40 0x3d0900 0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0x7a120>;
	#cooling-cells = <0x02>;
	qcom,wireless-fw-name = "cps4061.bin";
};

&pcie {
	power-domains = <&gcc 0x01>;
	power-domain-names = "gdsc-phy-vdd";
};

&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4-canoe";
	vdda-phy-supply = <&L4G>;
	vdda-phy-max-microamp = <0x3d16c>;
	vdda-phy-min-microvolt = <0xdea80>;
	vdda-pll-supply = <&L1D>;
	vdda-pll-max-microamp = <0x5168>;
	vdda-qref-supply = <&L3D>;
	vdda-qref-max-microamp = <0xa1108>;
	vdda-refgen-supply = <&L3I>;
	vdda-refgen-max-microamp = <0xd799c>;
	status = "ok";
};

&ufshc_mem {
	vcc-supply = <&L17B>;
	vcc-max-microamp = <0x124f80>;
	vccq-supply = <&L4D>;
	vccq-max-microamp = <0x124f80>;
	qcom,vccq-proxy-vote-supply = <&L4D>;
	qcom,vccq-proxy-vote-max-microamp = <0x124f80>;
	qcom,vddp-ref-clk-supply = <&L1G>;
	qcom,vddp-ref-clk-max-microamp = <0x64>;
	qcom,vccq-parent-supply = <&S7F>;
	qcom,vccq-parent-max-microamp = <0x7cc180>;
	reset-gpios = <&tlmm 0xd9 GPIO_ACTIVE_LOW>;
	resets = <&gcc 0x19>;
	reset-names = "rst";
	status = "ok";
};

&sdhc_2 {
	vdd-supply = <&L9B>;
	qcom,vdd-voltage-level = <0x2d0370 0x2d2a80>;
	qcom,vdd-current-level = <0x21 0xee868>;
	vdd-io-supply = <&L8B>;
	qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>;
	qcom,vdd-io-current-level = <0x00 0x55f0>;
	pinctrl-names = "default\0sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;
	cd-gpios = <&tlmm 0x37 GPIO_ACTIVE_HIGH>;
	resets = <&gcc 0x17>;
	reset-names = "core_reset";
	qcom,uses_level_shifter;
	status = "ok";
};

&usb_qmp_dp_phy {
	pinctrl-names = "unused";
};

&usb0 {
	lenovo,dual-port-data-switch;
	usb-role-switch;
	pinctrl-names = "default";
	pinctrl-0 = <&usb3phy_portselect_gpio>;
	gpios = <&tlmm 0x3c GPIO_ACTIVE_HIGH>;

	ports {

		port@0 {

			usb_port0: endpoint {
				remote-endpoint = <&usb_port0_connector>;
			};
		};

		port@1 {

			usb_port1: endpoint {
				remote-endpoint = <&usb_port1_connector>;
			};
		};
	};
};

&ucsi {

	connector {
		compatible = "usb-c-connector";

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				usb_port0_connector: endpoint {
					remote-endpoint = <&usb_port0>;
				};
			};

			port@1 {
				reg = <0x01>;

				ucsi_audio_mux0: endpoint {
				};
			};
		};
	};

	connector1 {
		compatible = "usb-c-connector";

		ports {

			port@0 {
				reg = <0x00>;

				usb_port1_connector: endpoint {
					remote-endpoint = <&usb_port1>;
				};
			};

			port@1 {
				reg = <0x01>;

				ucsi_audio_mux1: endpoint {
				};
			};
		};
	};
};

&tlmm {

	vib_reset_l: vib_reset_l {

		mux {
			pins = "gpio216";
			function = "gpio";
		};

		config {
			pins = "gpio216";
			bias-pull-up;
		};
	};

	vib_reset_r: vib_reset_r {

		mux {
			pins = "gpio215";
			function = "gpio";
		};

		config {
			pins = "gpio215";
			bias-pull-up;
		};
	};
};

&qupv3_se6_i2c {
	status = "ok";
	qcom,clk-freq-out = <0xf4240>;

	haptic_hv_l@5A {
		status = "ok";
		compatible = "awinic,haptic_hv_l";
		lenovo,effect-gain-waveforms = <3 5>;
		lenovo,fixed-gain-waveform = <5>;
		lenovo,loop-waveforms = <4 45 5 13>;
		lenovo,constant-waveform-offset = <1>;
		lenovo,rtp-waveform-start = <6>;
		reg = <0x5a>;
		irq-gpio = <&tlmm 0x63 GPIO_ACTIVE_HIGH>;
		reset-gpio = <&tlmm 0xd8 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vib_reset_l>;
		f0_pre = <0x6a4>;
		mode = [05];
		aw8693x_f0_cali_percent = [0f];
		aw8693x_gain_bypass = [01];
		aw8693x_uvlo_vol_default = [00];
		aw8693x_cont_smart_loop = [00];
		aw8693x_cont_drv1_lvl = [7f];
		aw8693x_cont_lra_vrms = <0x3e8>;
		aw8693x_cont_drv1_time = [04];
		aw8693x_cont_drv2_time = [14];
		aw8693x_cont_track_margin = [0f];
		aw8693x_cont_brk_gain = [08];
		aw8693x_cont_brk_time = [04];
		aw8693x_duration_time = [14 1e 3c];
		aw8693x_d2s_gain = [02];
		aw8693x_trig_config = <0x01 0x20000 0x01 0x20000 0x01 0x20000>;
		aw8693x_bst_vol_default = <0x2134>;
		aw8693x_is_enabled_track_en;
	};

	haptic_hv_r@5B {
		status = "ok";
		compatible = "awinic,haptic_hv_r";
		lenovo,effect-gain-waveforms = <3 5>;
		lenovo,fixed-gain-waveform = <5>;
		lenovo,loop-waveforms = <4 45 5 13>;
		lenovo,constant-waveform-offset = <1>;
		lenovo,rtp-waveform-start = <6>;
		reg = <0x5b>;
		irq-gpio = <&tlmm 0x5f GPIO_ACTIVE_HIGH>;
		reset-gpio = <&tlmm 0xd7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vib_reset_r>;
		f0_pre = <0x6a4>;
		mode = [05];
		aw8693x_f0_cali_percent = [0f];
		aw8693x_gain_bypass = [01];
		aw8693x_uvlo_vol_default = [00];
		aw8693x_cont_smart_loop = [00];
		aw8693x_cont_drv1_lvl = [7f];
		aw8693x_cont_lra_vrms = <0x3e8>;
		aw8693x_cont_drv1_time = [04];
		aw8693x_cont_drv2_time = [14];
		aw8693x_cont_track_margin = [0f];
		aw8693x_cont_brk_gain = [08];
		aw8693x_cont_brk_time = [04];
		aw8693x_duration_time = [14 1e 3c];
		aw8693x_d2s_gain = [02];
		aw8693x_trig_config = <0x01 0x20000 0x01 0x20000 0x01 0x20000>;
		aw8693x_bst_vol_default = <0x2134>;
		aw8693x_is_enabled_track_en;
	};
};

&qupv3_se5_i2c {
	status = "ok";
	#address-cells = <0x01>;
	#size-cells = <0x00>;

	nxp_eusb2_repeater: eusb2_repeater@4f {
		status = "ok";
		compatible = "nxp,eusb2-repeater";
		reg = <0x4f>;
		vdd18-supply = <&L15B_E0>;
		vdd3-supply = <&L5B_E0>;
		reset-gpio = <&pmh0110_f_gpios 0x0e GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&eusb2_reset_ctrl_default>;
		qcom,param-override-seq-c1 = <0x30 0x06 0x22 0x07 0x66 0x08 0x03 0x0a>;
		qcom,param-override-seq-c2 = <0x30 0x06 0x22 0x07 0x66 0x08 0x03 0x0a>;
	};
};

&ucsi {
	compatible = "lenovo,dual-port-ucsi-glink-v1", "qcom,ucsi-glink";
	lenovo,analog-audio-switch-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
	gpios = <&tlmm 0x1e GPIO_ACTIVE_HIGH>;
};

&eusb2_phy0 {
	dummy-supply = <&nxp_eusb2_repeater>;
	usb-repeater = <&nxp_eusb2_repeater>;
};

&tlmm {

	tp_reset_gpio: tp_reset_gpio {

		mux {
			pins = "gpio66";
			function = "gpio";
			drive-strength = <0x10>;
		};

		config {
			pins = "gpio66";
			bias-pull-up;
		};
	};
};

