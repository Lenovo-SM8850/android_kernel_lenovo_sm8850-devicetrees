		compatible = "qcom,spmi-pmic";
		reg = <0x09 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pmh0104";
		};

		pmh0104_tz: pmh0104-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x09 0x0a 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
		};

		pmh0104_gpios: pinctrl@8800 {
			compatible = "qcom,pmh0104-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;

			bt_en: bt_en {
				power-source = <0x01>;
				bias-disable;
				output-enable;
				input-disable;
				function = PMIC_GPIO_FUNC_NORMAL;
				pins = "gpio5";
			};

			bt_fmd_clk_en: bt_fmd_clk_en {
				power-source = <0x01>;
				bias-disable;
				output-disable;
				input-enable;
				function = PMIC_GPIO_FUNC_NORMAL;
				pins = "gpio6";
			};
		};
	};

	qcom,pmr735d@a {
		compatible = "qcom,spmi-pmic";
		reg = <0x0a 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmr735d_ecid: pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pmr735d";
		};

		pmr735d_tz: pmr735d-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x0a 0x0a 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
		};

		pmr735d_gpios: pinctrl@8800 {
			compatible = "qcom,pmr735d-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	pm8010_m: qcom,pm8010@c {
		compatible = "qcom,spmi-pmic";
		reg = <0x0c 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pm8010_m";
		};

		pm8010m_tz: pm8010m-temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400>;
			interrupts = <0x0c 0x24 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
		};
	};

	pm8010_n: qcom,pm8010@d {
		compatible = "qcom,spmi-pmic";
		reg = <0x0d 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		pmic-ecid@100 {
			compatible = "qcom,pmic-ecid";
			reg = <0x100>;
			qcom,pmic-name = "pm8010_n";
		};

		pm8010n_tz: pm8010n-temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400>;
			interrupts = <0x0d 0x24 0x00 IRQ_TYPE_EDGE_BOTH>;
			#thermal-sensor-cells = <0x00>;
		};
	};
};

&soc {

	reboot_reason {
		compatible = "qcom,reboot-reason";
		nvmem-cells = <&restart_reason>;
		nvmem-cell-names = "restart_reason";
