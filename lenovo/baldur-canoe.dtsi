		pinctrl-0 = <&sde_te_active &sde_disp0_rst_1p8_active>;
		pinctrl-names = "panel_active\0panel_active_with_esync\0panel_active_with_esync_without_te\0panel_suspend\0iovdd_enable\0iovdd_disable";
		tvdd-supply = <&L4B>;
		vdd-supply = <&L11B>;
		vci-supply = <&L13B>;
		vddio-supply = <&L12B>;
		clock-names = "pll_byte_clk0\0pll_dsi_clk0\0pll_byte_clk1\0pll_dsi_clk1\0mdp_core_clk\0esync_clk_rcg";
		clocks = <&mdss_dsi_phy0 0x00 &mdss_dsi_phy0 0x01 &mdss_dsi_phy1 0x00 &mdss_dsi_phy1 0x01 &dispcc 0x43 &dispcc 0x01>;
		qcom,demura-panel-id = <0x122e700 0x471>;
		qcom,dsi-default-panel = <&baldur_nt36523_csot_3k_dsc_vid>;
		qcom,mdp = <&mdss_mdp>;
		qcom,panel-te-source = <0x00>;
		qcom,platform-te-gpio = <&tlmm 0x56 GPIO_ACTIVE_HIGH>;
		qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
		qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "primary";
		compatible = "qcom,dsi-display";
	};

	sde_dsi1: qcom,dsi-display-secondary {
		pinctrl-3 = <&sde_dsi1_suspend &sde_te1_suspend &sde_esync1_suspend>;
		pinctrl-2 = <&sde_dsi1_active &sde_te1_function0 &sde_esync1_active>;
		pinctrl-1 = <&sde_dsi1_active &sde_te1_active &sde_esync1_active>;
		pinctrl-0 = <&sde_dsi1_active &sde_te1_active &sde_esync1_suspend>;
		pinctrl-names = "panel_active\0panel_active_with_esync\0panel_active_with_esync_without_te\0panel_suspend";
		tvdd-supply = <&L4B>;
		vdd-supply = <&L11B>;
		vci-supply = <&L13B>;
		vddio-supply = <&L12B>;
		clock-names = "pll_byte_clk0\0pll_dsi_clk0\0pll_byte_clk1\0pll_dsi_clk1\0mdp_core_clk\0esync_clk_rcg";
		clocks = <&mdss_dsi_phy0 0x00 &mdss_dsi_phy0 0x01 &mdss_dsi_phy1 0x00 &mdss_dsi_phy1 0x01 &dispcc 0x43 &dispcc 0x03>;
		qcom,demura-panel-id = <0x00 0x00>;
		qcom,mdp = <&mdss_mdp>;
		qcom,panel-te-source = <0x01>;
		qcom,platform-te-gpio = <&tlmm 0x57 GPIO_ACTIVE_HIGH>;
		qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
		qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "secondary";
		compatible = "qcom,dsi-display";
	};
};

&qupv3_se12_i2c {
	status = "okay";

	bias@3e {
		pinctrl-3 = <&bias_enn_sleep>;
		pinctrl-2 = <&bias_enp_sleep>;
		pinctrl-1 = <&bias_enn_active>;
		pinctrl-0 = <&bias_enp_active>;
		pinctrl-names = "enp_active\0enn_active\0enp_sleep\0enn_sleep";
		reg = <0x3e>;
		compatible = "bias";
	};

	bl@76 {
		pinctrl-1 = <&bl_sleep>;
		pinctrl-0 = <&bl_active>;
		pinctrl-names = "default\0sleep";
		reg = <0x76>;
		compatible = "i2c-backlight";
		lenovo,lcd-backlight;
	};
};

&soc {

	sde_wb0: qcom,wb-display@0 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x43>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "wb_display0";
		cell-index = <0x00>;
		compatible = "qcom,wb-display";
	};

	sde_wb1: qcom,wb-display@1 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x43>;
		status = "ok";
		qcom,op-label = "hwio";
		label = "wb_display1";
		cell-index = <0x01>;
		compatible = "qcom,wb-display";
	};

	display_panel_avdd: display_gpio_regulator@1 {
		pinctrl-names = "default";
		qcom,proxy-consumer-enable;
		proxy-supply = <&display_panel_avdd>;
		regulator-boot-on;
		enable-active-high;
		gpio = <&pmh0104_gpios 0x07 GPIO_ACTIVE_HIGH>;
		regulator-enable-ramp-delay = <0xe9>;
		regulator-max-microvolt = <0x53ec60>;
		regulator-min-microvolt = <0x53ec60>;
		regulator-name = "display_panel_avdd";
		compatible = "qti-regulator-fixed";
	};

	display_panel_vdd: display_gpio_regulator@2 {
		pinctrl-0 = <&sde_disp0_vdd_active>;
		pinctrl-names = "default";
		qcom,proxy-consumer-enable;
		proxy-supply = <&display_panel_vdd>;
		regulator-boot-on;
		enable-active-high;
		gpio = <&pmd802x_gpios 0x02 GPIO_ACTIVE_HIGH>;
		regulator-enable-ramp-delay = <0xe9>;
		regulator-max-microvolt = <0x10c8e0>;
		regulator-min-microvolt = <0x10c8e0>;
		regulator-name = "display_panel_vdd";
		compatible = "qti-regulator-fixed";
	};

	disp_rdump_memory: disp_rdump_region@0xfc800000 {
		label = "disp_rdump_region";
		reg = <0xfc800000 0x800000>;
	};
};

&reserved_memory {

	splash_memory: splash_region {
		label = "cont_splash_region";
		reg = <0x00 0xfc800000 0x00 0x2b00000>;
	};

	demura_memory_0: demura_region_0 {
		label = "demura hfc region 0";
		reg = <0x00 0x00 0x00 0x00>;
	};

	demura_memory_1: demura_region_1 {
		label = "demura hfc region 1";
		reg = <0x00 0x00 0x00 0x00>;
	};
};

&mdss_mdp {
	connectors = <&sde_dsi &sde_dsi1 &smmu_sde_unsec &smmu_sde_sec &sde_wb0 &sde_wb1 &sde_dp &sde_cesta>;
};

