		qcom,demura-panel-id = <0x122e700 0x471>;
		qcom,dsi-default-panel = <&dsi_nt37801_amoled_cmd>;
		qcom,mdp = <&mdss_mdp1>;
		qcom,panel-te-source = <0x00>;
