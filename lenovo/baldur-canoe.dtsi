&thermal_zones {

	socd {
		polling-delay-passive = <0x64>;
		thermal-sensors = <&bcl_soc>;

		trips {

			thermal-engine-trip {
				temperature = <0x64>;
				hysteresis = <0x00>;
				type = "passive";
			};

			thermal-hal-trip {
				temperature = <0x5a>;
				hysteresis = <0x00>;
				type = "passive";
			};

			socd_trip: socd-trip {
				temperature = <0x5a>;
				hysteresis = <0x00>;
				type = "passive";
			};
		};

		cooling-maps {
		};
	};

	pmih010x-ibat-lvl0 {
