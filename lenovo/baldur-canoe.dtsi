&tlmm {

	cnss_pins {

		cnss_wlan_en_active: cnss_wlan_en_active {

			mux {
				function = "gpio";
				pins = "gpio16";
			};

			config {
				bias-pull-up;
				output-high;
				drive-strength = <0x10>;
				pins = "gpio16";
			};
		};

		cnss_wlan_en_sleep: cnss_wlan_en_sleep {

			mux {
				function = "gpio";
				pins = "gpio16";
			};

			config {
				bias-pull-down;
				output-low;
				drive-strength = <0x02>;
				pins = "gpio16";
			};
		};

		cnss_wlan_sw_ctrl: cnss_wlan_sw_ctrl {

			mux {
				function = "wcn_sw_ctrl";
				pins = "gpio18";
			};
		};

		cnss_wlan_sw_ctrl_wl_cx: cnss_wlan_sw_ctrl_wl_cx {

			mux {
				function = "wcn_sw";
				pins = "gpio19";
			};
		};

		cnss_host_sol_default: cnss_host_sol_default {

			mux {
				function = "gpio";
				pins = "gpio204";
			};

			config {
				bias-pull-down;
				drive-strength = <0x04>;
				pins = "gpio204";
			};
		};
	};
};

