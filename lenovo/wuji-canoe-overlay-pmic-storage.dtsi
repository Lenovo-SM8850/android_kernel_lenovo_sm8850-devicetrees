#include "canoe-common-components.dtsi"
// Canoe power, charging, and storage fragments.
	fragment@0 {
		target = <&spmi0_bus>;
		__overlay__ {
			lenovo_48: pmk8850@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0 0>;
				#address-cells = <0x1>;
				#size-cells = <0>;
				pmic-ecid@100 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PMIC_ECID_100_BODY;
				};
				lenovo_49: sdam@7000 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_7000_PROPERTIES;
					reg = "", "", "p";
					#address-cells = <0x1>;
					#size-cells = <0x1>;
					lenovo_11: ocp-log@76 {
						reg = <0x76 0x6>;
					};
				};
				lenovo_4a: sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = "", "", "q";
					#address-cells = <0x1>;
					#size-cells = <0x1>;
					lenovo_e: restart@48 {
						reg = <0x48 0x1>;
						bits = <0x1 0x7>;
					};
					lenovo_4b: bob1-off-mode-enable@50 {
						reg = <0x50 0x1>;
					};
					lenovo_4c: xo_calib-data@59 {
						reg = <0x59 0x1>;
					};
					lenovo_12: alarm-log@76 {
						reg = <0x76 0x6>;
					};
					lenovo_4d: fmd-set@9a {
						reg = <0x9a 0x1>;
					};
					lenovo_4e: fmd_cont_after_pon@9c {
						reg = <0x9c 0x1>;
					};
					lenovo_4f: fmd-chg-pon@9f {
						reg = <0x9f 0x1>;
					};
					lenovo_50: fmd-cnt2-stop@a2 {
						reg = <0xa2 0x1>;
					};
				};
				lenovo_f: sdam@7400 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_7000_PROPERTIES;
					reg = "", "", "t";
				};
				lenovo_10: sdam@7500 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_7000_PROPERTIES;
					reg = "", "", "u";
				};
				lenovo_7: sdam@8400 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_8400_BODY;
				};
				lenovo_8: sdam@8500 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_8500_BODY;
				};
				lenovo_51: sdam@9a00 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_9A00_PROPERTIES;
					#address-cells = <0x1>;
					#size-cells = <0x1>;
					lenovo_c: sqm-timer@b8 {
						reg = <0xb8 0x2>;
					};
				};
				lenovo_d: sdam@9d00 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_9D00_BODY;
				};
				lenovo_9: sdam@aa00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xaa00>;
				};
				lenovo_a: sdam@ab00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xab00>;
				};
				lenovo_b: sdam@ac00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xac00>;
				};
				pon_hlos@1300 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PON_HLOS_1300_PROPERTIES;
					reg-names = "hlos", "pbs";
					pwrkey {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PON_HLOS_1300_PWRKEY_PROPERTIES;
						interrupts = <0x0 0x13 0x7 0x3>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PON_HLOS_1300_PWRKEY_PROPERTIES_2;
					};
					resin {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PON_HLOS_1300_RESIN_PROPERTIES;
						interrupts = <0x0 0x13 0x6 0x3>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PON_HLOS_1300_RESIN_PROPERTIES_2;
					};
				};
				lenovo_2: sdam@a000 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_A000_BODY;
				};
				lenovo_3: sdam@a100 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_A100_BODY;
				};
				lenovo_4: sdam@a200 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_A200_BODY;
				};
				lenovo_52: sdam@b600 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_B600_PROPERTIES;
					lenovo_53: usb-mode@50 {
						reg = <0x50 0x1>;
					};
				};
				lenovo_5: sdam@b700 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_SDAM_B700_BODY;
				};
				lenovo_54: pinctrl@b800 {
					compatible = "qcom,pmk8850-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x2>;
					interrupt-controller;
					#interrupt-cells = <0x2>;
					lenovo_55: lcd-bl-pwm-default-state {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_LCD_BL_PWM_DEFAULT_STATE_PROPERTIES;
						function = "func3";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_LCD_BL_PWM_DEFAULT_STATE_PROPERTIES_2;
						power-source = "", "", "", "";
					};
					lenovo_56: xoagg-therm-default-state {
						pins = "gpio7";
						function = "normal";
						bias-high-impedance;
					};
					lcm_therm {
						lenovo_3f: lcm_therm_default {
							LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_LCM_THERM_LCM_THERM_DEFAULT_BODY;
						};
					};
					lenovo_e5: cam_sensor_mclk0_1p8_active {
						power-source = "", "", "", "";
						output-enable;
						function = "func2";
						pins = "gpio1";
					};
					lenovo_e7: cam_sensor_mclk0_1p8_suspend {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
						function = "func2";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES_2;
					};
					lenovo_ee: cam_sensor_mclk1_1p8_active {
						power-source = "", "", "", "";
						output-enable;
						function = "func2";
						pins = "gpio8";
					};
					lenovo_f0: cam_sensor_mclk1_1p8_suspend {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
						function = "func2";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK1_1P8_SUSPEND_PROPERTIES;
					};
				};
				lenovo_57: rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = "", "", "a", "", "", "b";
					reg-names = "rtc", "alarm";
					interrupts = <0x0 0x62 0x1 0x1>;
				};
				pmk8850-pwm {
					compatible = "qcom,pmk8850-pwm", "qcom,pmk8550-pwm";
					#address-cells = <0x1>;
					#size-cells = <0>;
					#pwm-cells = <0x2>;
				};
				lenovo_6: vadc@9000 {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PROPERTIES;
					#address-cells = <0x1>;
					#size-cells = <0>;
					interrupts = <0x0 0x90 0x1 0x1 0x0 0x91 0x1 0x1>;
					interrupt-names = "adc-sdam0", "adc-sdam1";
					#thermal-sensor-cells = <0x1>;
					#io-channel-cells = <0x1>;
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PROPERTIES_2;
					pinctrl-0 = <&lenovo_1>;
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PROPERTIES_3;
					pmk8850_offset_ref {
						reg = "", "", "", "";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMK8850_OFFSET_REF_PROPERTIES;
					};
					pmk8850_vref_1p25 {
						reg = <0x1>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMK8850_VREF_1P25_PROPERTIES;
					};
					pmk8850_die_temp {
						reg = <0x3>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMK8850_DIE_TEMP_PROPERTIES;
					};
					pmk8850_xo_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMK8850_XO_THERM_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					lenovo_58: pmk8850_xoagg_therm {
						reg = <0x4b>;
						label = "pmk8850_xoagg_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
						status = "disabled";
					};
					pmh0101_offset_ref {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_OFFSET_REF_BODY;
					};
					pmh0101_vref_1p25 {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_VREF_1P25_BODY;
					};
					pmh0101_die_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_DIE_TEMP_BODY;
					};
					pmh0101_vph_pwr {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_VPH_PWR_BODY;
					};
					lenovo_59: pmh0101_qtm_therm {
						status = "okay";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_QTM_THERM_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0110_d_die_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_D_DIE_TEMP_BODY;
					};
					pmh0110_d_vph_pwr {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_D_VPH_PWR_BODY;
					};
					pmh0110_f_die_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_F_DIE_TEMP_BODY;
					};
					pmh0110_f_vph_pwr {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_F_VPH_PWR_BODY;
					};
					pmh0110_g_die_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_G_DIE_TEMP_BODY;
					};
					pmh0110_g_vph_pwr {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_G_VPH_PWR_BODY;
					};
					pmh0110_i_die_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_I_DIE_TEMP_BODY;
					};
					pmh0110_i_vph_pwr {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0110_I_VPH_PWR_BODY;
					};
					pmih010x_offset_ref {
						reg = "", "", "'";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_OFFSET_REF_PROPERTIES;
					};
					pmih010x_vref_1p25 {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_VREF_1P25_BODY;
					};
					pmih010x_die_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_DIE_TEMP_BODY;
					};
					pmih010x_vph_pwr {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_VPH_PWR_BODY;
					};
					pmih010x_vbat_sns_qbg {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_VBAT_SNS_QBG_BODY;
					};
					pmih010x_iin {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_IIN_BODY;
					};
					pmih010x_ichg_fb {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_ICHG_FB_BODY;
					};
					pmih010x_chg_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_CHG_TEMP_BODY;
					};
					pmih010x_lite_die_temp {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_LITE_DIE_TEMP_BODY;
					};
					pmih010x_batt_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_BATT_THERM_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_usb_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_USB_THERM_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_batt_therm2 {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_BATT_THERM2_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_wls_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_WLS_THERM_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_skin_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_SKIN_THERM_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_rear_cam_ntc {
						reg = <0x145>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_REAR_CAM_NTC_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_wlan_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_WLAN_THERM_PROPERTIES;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_usb2_conn_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_USB2_CONN_THERM_PROPERTIES;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_flash_led_ntc {
						reg = <0x14a>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_FLASH_LED_NTC_PROPERTIES;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_quiet_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMH0101_QUIET_THERM_PROPERTIES;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_ufs_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_UFS_THERM_PROPERTIES;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_UFS_THERM_PROPERTIES_2;
					};
					pmih010x_fcam_ntc {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_FCAM_NTC_PROPERTIES;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_UFS_THERM_PROPERTIES_2;
					};
					pmk8850_lcm_therm {
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMK8850_LCM_THERM_PROPERTIES;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_VADC_9000_PMIH010X_UFS_THERM_PROPERTIES_2;
					};
				};
				lenovo_13: qcom,power-telemetry-device {
					compatible = "qcom,power-telemetry";
					status = "okay";
					interrupts = <0x0 0xa2 0x1 0x1 0x0 0xa1 0x1 0x1>;
					nvmem = <&lenovo_2 &lenovo_3 &lenovo_4>;
					nvmem-names = "qpt-config-sdam", "qpt-frac-sdam", "qpt-data-sdam";
					#powerzone-cells = <0x1>;
					power-domains = <&CLUSTER_PD2>;
				};
				lenovo_5a: qcom,voltage-adj-device {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_QCOM_VOLTAGE_ADJ_DEVICE_BODY;
				};
				btl {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_BTL_PROPERTIES;
					nvmem = <&lenovo_5>;
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_BTL_PROPERTIES_2;
				};
				qcom,power-telemetry-data-share-device {
					LENOVO_CANOE_SPMI0_BUS_PMK8850_0_QCOM_POWER_TELEMETRY_DATA_SHARE_DEVICE_BODY;
				};
			};
			pmh0101@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x1 0x0>;
				#address-cells = <0x1>;
				#size-cells = <0>;
				pmic-ecid@100 {
					LENOVO_CANOE_SPMI0_BUS_PMH0101_1_PMIC_ECID_100_BODY;
				};
				lenovo_1e: pmh0101-temp-alarm@a00 {
					LENOVO_CANOE_SPMI0_BUS_PMH0101_1_PMH0101_TEMP_ALARM_A00_PROPERTIES;
					reg = "", "", "\n";
					interrupts = <0x1 0xa 0x0 0x3>;
					#thermal-sensor-cells = "", "", "", "";
					io-channels = <&lenovo_6 0x103>;
					LENOVO_CANOE_SPMI0_BUS_PMH0101_1_PMH0101_TEMP_ALARM_A00_PROPERTIES_2;
				};
				lenovo_5b: pinctrl@8800 {
					compatible = "qcom,pmh0101-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x2>;
					interrupt-controller;
					#interrupt-cells = <0x2>;
					lenovo_5c: qtm-therm-default-state {
						LENOVO_CANOE_SPMI0_BUS_PMH0101_1_PINCTRL_8800_QTM_THERM_DEFAULT_STATE_PROPERTIES;
						function = "normal";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
					};
					lenovo_1: pa-therm2-default-state {
						LENOVO_CANOE_SPMI0_BUS_PMH0101_1_PINCTRL_8800_PA_THERM2_DEFAULT_STATE_PROPERTIES;
						function = "normal";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
					};
					lenovo_5d: cam-sensor-1p8-rst0-active-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x2>;
						input-disable;
						output-enable;
						output-high;
						power-source = "", "", "", "";
					};
					lenovo_5e: cam-sensor-1p8-rst0-suspend-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x2>;
						input-disable;
						output-enable;
						output-low;
					};
					lenovo_5f: pmh0101-bidir-lvl-shifter1-state {
						pins = "gpio11", "gpio12";
						function = "normal";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
					};
					lenovo_60: pmh0101-bidir-lvl-shifter2-state {
						pins = "gpio13", "gpio14";
						function = "normal";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
					};
					lenovo_61: pmh0101-bidir-lvl-shifter3-state {
						pins = "gpio15", "gpio16";
						function = "normal";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
					};
					lenovo_62: pmh0101-bidir-lvl-shifter4-state {
						pins = "gpio17", "gpio18";
						function = "normal";
						LENOVO_CANOE_SPMI0_BUS_PMK8850_0_PINCTRL_B800_CAM_SENSOR_MCLK0_1P8_SUSPEND_PROPERTIES;
					};
					flash_led_ntc {
						lenovo_38: flash_led_ntc_default {
							pins = "gpio1";
							bias-high-impedance;
						};
					};
					quiet_therm {
						lenovo_39: quiet_therm_default {
							LENOVO_CANOE_SPMI0_BUS_PMH0101_1_PINCTRL_8800_QUIET_THERM_QUIET_THERM_DEFAULT_BODY;
						};
