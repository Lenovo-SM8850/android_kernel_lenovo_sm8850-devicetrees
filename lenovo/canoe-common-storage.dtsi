// Shared Canoe storage node data.
#ifndef LENOVO_CANOE_COMMON_STORAGE_DTSI
#define LENOVO_CANOE_COMMON_STORAGE_DTSI

#define LENOVO_CANOE_UFSPHY_MEM_BODY \
	compatible = "qcom,ufs-phy-qmp-v4-canoe"; \
	vdda-phy-supply = <&L4G>; \
	vdda-phy-max-microamp = <0x3d16c>; \
	vdda-phy-min-microvolt = <0xdea80>; \
	vdda-pll-supply = <&L1D>; \
	vdda-pll-max-microamp = <0x5168>; \
	vdda-qref-supply = <&L3D>; \
	vdda-qref-max-microamp = <0xa1108>; \
	vdda-refgen-supply = <&L3I>; \
	vdda-refgen-max-microamp = <0xd799c>; \
	status = "ok"

#define LENOVO_CANOE_SDHC_2_PROPERTIES \
	vdd-supply = <&L9B>; \
	qcom,vdd-voltage-level = <0x2d0370 0x2d2a80>; \
	qcom,vdd-current-level = <0x21 0xee868>; \
	vdd-io-supply = <&L8B>; \
	qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>

#define LENOVO_CANOE_SDHC_2_PROPERTIES_2 \
	pinctrl-0 = <&sdc2_on>; \
	pinctrl-1 = <&sdc2_off>

#define LENOVO_CANOE_SDHC_2_PROPERTIES_3 \
	resets = <&gcc 0x17>; \
	reset-names = "core_reset"; \
	qcom,uses_level_shifter

#define LENOVO_CANOE_SDHC_2_PROPERTIES_4 \
	status = "ok"

#endif
