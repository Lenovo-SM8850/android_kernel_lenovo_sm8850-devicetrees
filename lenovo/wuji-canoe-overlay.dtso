// SPDX-License-Identifier: GPL-2.0
// NFC/eSE fragments omitted: hardware is not fitted.
/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. Canoe QRD + ST54L + Pandeiro";
	compatible = "qcom,canoe-qrd", "qcom,canoe", "qcom,canoep-cdp", "qcom,canoep", "qcom,qrd";
	qcom,msm-id = <0x294 0x20000>;
	qcom,board-id = <0x2000b 0x0>;
	fragment@0 {
		target = <&spmi0_bus>;
		__overlay__ {
			lenovo_48: pmk8850@0 {
				compatible = "qcom,spmi-pmic";
				reg = "", "", "", "", "", "", "", "";
				#address-cells = <0x1>;
				#size-cells = "", "", "", "";
				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmk8850";
				};
				lenovo_49: sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = "", "", "p";
					#address-cells = <0x1>;
					#size-cells = <0x1>;
					lenovo_11: ocp-log@76 {
						reg = <0x76 0x6>;
					};
				};
				lenovo_4a: sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = "", "", "q";
					#address-cells = <0x1>;
					#size-cells = <0x1>;
					lenovo_e: restart@48 {
						reg = <0x48 0x1>;
						bits = <0x1 0x7>;
					};
					lenovo_4b: bob1-off-mode-enable@50 {
						reg = <0x50 0x1>;
					};
					lenovo_4c: xo_calib-data@59 {
						reg = <0x59 0x1>;
					};
					lenovo_12: alarm-log@76 {
						reg = <0x76 0x6>;
					};
					lenovo_4d: fmd-set@9a {
						reg = <0x9a 0x1>;
					};
					lenovo_4e: fmd_cont_after_pon@9c {
						reg = <0x9c 0x1>;
					};
					lenovo_4f: fmd-chg-pon@9f {
						reg = <0x9f 0x1>;
					};
					lenovo_50: fmd-cnt2-stop@a2 {
						reg = <0xa2 0x1>;
					};
				};
				lenovo_f: sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = "", "", "t";
				};
				lenovo_10: sdam@7500 {
					compatible = "qcom,spmi-sdam";
					reg = "", "", "u";
				};
				lenovo_7: sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
				};
				lenovo_8: sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
				};
				lenovo_51: sdam@9a00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9a00>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;
					lenovo_c: sqm-timer@b8 {
						reg = <0xb8 0x2>;
					};
				};
				lenovo_d: sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
				};
				lenovo_9: sdam@aa00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xaa00>;
				};
				lenovo_a: sdam@ab00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xab00>;
				};
				lenovo_b: sdam@ac00 {
					compatible = "qcom,spmi-sdam";
					reg = <0xac00>;
				};
				pon_hlos@1300 {
					compatible = "qcom,pmk8350-pon";
					reg = <0x1300 0x800>;
					reg-names = "hlos", "pbs";
					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x0 0x13 0x7 0x3>;
						linux,code = <0x74>;
					};
					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x0 0x13 0x6 0x3>;
						linux,code = <0x72>;
					};
				};
				lenovo_2: sdam@a000 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa000>;
				};
				lenovo_3: sdam@a100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa100>;
				};
				lenovo_4: sdam@a200 {
					compatible = "qcom,spmi-sdam";
					reg = <0xa200>;
				};
				lenovo_52: sdam@b600 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb600>;
					lenovo_53: usb-mode@50 {
						reg = <0x50 0x1>;
					};
				};
				lenovo_5: sdam@b700 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb700>;
				};
				lenovo_54: pinctrl@b800 {
					compatible = "qcom,pmk8850-gpio";
					reg = <0xb800>;
					gpio-controller;
					#gpio-cells = <0x2>;
					interrupt-controller;
					#interrupt-cells = <0x2>;
					lenovo_55: lcd-bl-pwm-default-state {
						pins = "gpio5";
						function = "func3";
						input-disable;
						output-enable;
						power-source = "", "", "", "";
					};
					lenovo_56: xoagg-therm-default-state {
						pins = "gpio7";
						function = "normal";
						bias-high-impedance;
					};
					lcm_therm {
						lenovo_3f: lcm_therm_default {
							pins = "gpio3";
							bias-high-impedance;
						};
					};
					lenovo_e5: cam_sensor_mclk0_1p8_active {
						power-source = "", "", "", "";
						output-enable;
						function = "func2";
						pins = "gpio1";
					};
					lenovo_e7: cam_sensor_mclk0_1p8_suspend {
						bias-high-impedance;
						function = "func2";
						pins = "gpio1";
					};
					lenovo_ee: cam_sensor_mclk1_1p8_active {
						power-source = "", "", "", "";
						output-enable;
						function = "func2";
						pins = "gpio8";
					};
					lenovo_f0: cam_sensor_mclk1_1p8_suspend {
						bias-high-impedance;
						function = "func2";
						pins = "gpio8";
					};
				};
				lenovo_57: rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = "", "", "a", "", "", "b";
					reg-names = "rtc", "alarm";
					interrupts = <0x0 0x62 0x1 0x1>;
				};
				pmk8850-pwm {
					compatible = "qcom,pmk8850-pwm", "qcom,pmk8550-pwm";
					#address-cells = <0x1>;
					#size-cells = "", "", "", "";
					#pwm-cells = <0x2>;
				};
				lenovo_6: vadc@9000 {
					compatible = "qcom,spmi-adc5-gen4";
					reg = <0x9000 0x9100>;
					#address-cells = <0x1>;
					#size-cells = "", "", "", "";
					interrupts = <0x0 0x90 0x1 0x1 0x0 0x91 0x1 0x1>;
					interrupt-names = "adc-sdam0", "adc-sdam1";
					#thermal-sensor-cells = <0x1>;
					#io-channel-cells = <0x1>;
					io-channel-ranges;
					pinctrl-0 = <&lenovo_1>;
					pinctrl-names = "default";
					/* Gen6 reference-board channels are absent on stock Wuji. */
					pmh0101_cam_flash_therm { status = "disabled"; };
					pmh0101_pa_therm1 { status = "disabled"; };
					pmh0101_pa_therm2 { status = "disabled"; };
					pmk8850_offset_ref {
						reg = "", "", "", "";
						label = "pmk8850_offset_ref";
					};
					pmk8850_vref_1p25 {
						reg = <0x1>;
						label = "pmk8850_vref_1p25";
					};
					pmk8850_die_temp {
						reg = <0x3>;
						label = "pmk8850_die_temp";
					};
					pmk8850_xo_therm {
						reg = <0x44>;
						label = "pmk8850_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					lenovo_58: pmk8850_xoagg_therm {
						reg = <0x4b>;
						label = "pmk8850_xoagg_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
						status = "disabled";
					};
					pmh0101_offset_ref {
						reg = <0x100>;
						label = "pmh0101_offset_ref";
					};
					pmh0101_vref_1p25 {
						reg = <0x101>;
						label = "pmh0101_vref_1p25";
					};
					pmh0101_die_temp {
						reg = <0x103>;
						label = "pmh0101_die_temp";
					};
					pmh0101_vph_pwr {
						reg = <0x18e>;
						label = "pmh0101_vph_pwr";
					};
					lenovo_59: pmh0101_qtm_therm {
						status = "okay";
						reg = <0x14b>;
						label = "pmh0101_qtm_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0110_d_die_temp {
						reg = <0x303>;
						label = "pmh0110_d_die_temp";
					};
					pmh0110_d_vph_pwr {
						reg = <0x38e>;
						label = "pmh0110_d_vph_pwr";
					};
					pmh0110_f_die_temp {
						reg = <0x503>;
						label = "pmh0110_f_die_temp";
					};
					pmh0110_f_vph_pwr {
						reg = <0x58e>;
						label = "pmh0110_f_vph_pwr";
					};
					pmh0110_g_die_temp {
						reg = <0x603>;
						label = "pmh0110_g_die_temp";
					};
					pmh0110_g_vph_pwr {
						reg = <0x68e>;
						label = "pmh0110_g_vph_pwr";
					};
					pmh0110_i_die_temp {
						reg = <0x803>;
						label = "pmh0110_i_die_temp";
					};
					pmh0110_i_vph_pwr {
						reg = <0x88e>;
						label = "pmh0110_i_vph_pwr";
					};
					pmih010x_offset_ref {
						reg = "", "", "'";
						label = "pmih010x_offset_ref";
					};
					pmih010x_vref_1p25 {
						reg = <0x2701>;
						label = "pmih010x_vref_1p25";
					};
					pmih010x_die_temp {
						reg = <0x2703>;
						label = "pmih010x_die_temp";
					};
					pmih010x_vph_pwr {
						reg = <0x278e>;
						label = "pmih010x_vph_pwr";
					};
					pmih010x_vbat_sns_qbg {
						reg = <0x278f>;
						label = "pmih010x_vbat_sns_qbg";
					};
					pmih010x_iin {
						reg = <0x2717>;
						label = "pmih010x_iin";
					};
					pmih010x_ichg_fb {
						reg = <0x27a1>;
						label = "pmih010x_ichg_fb";
					};
					pmih010x_chg_temp {
						reg = <0x2710>;
						label = "pmih010x_chg_temp";
					};
					pmih010x_lite_die_temp {
						reg = <0x2718>;
						label = "pmih010x_lite_die_temp";
					};
					pmih010x_batt_therm {
						reg = <0x2744>;
						label = "pmih010x_batt_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_usb_therm {
						reg = <0x2747>;
						label = "pmih010x_usb_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_batt_therm2 {
						reg = <0x274c>;
						label = "pmih010x_batt_therm_2";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_wls_therm {
						reg = <0x274d>;
						label = "pmih010x_wls_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_skin_therm {
						reg = <0x144>;
						label = "pmh0101_skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_rear_cam_ntc {
						reg = <0x145>;
						label = "pmh0101_rear_cam_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_wlan_therm {
						reg = <0x146>;
						label = "pmh0101_wlan_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_usb2_conn_therm {
						reg = <0x148>;
						label = "pmh0101_usb2_conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_flash_led_ntc {
						reg = <0x14a>;
						label = "pmh0101_flash_led_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
					};
					pmh0101_quiet_therm {
						reg = <0x14c>;
						label = "pmh0101_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
					};
					pmih010x_ufs_therm {
						reg = <0x274b>;
						label = "pmih010x_ufs_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
						qcom,adc5-gen4;
					};
					pmih010x_fcam_ntc {
						reg = <0x275e>;
						label = "pmih010x_fcam_ntc";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
						qcom,adc5-gen4;
					};
					pmk8850_lcm_therm {
						reg = <0x47>;
						label = "pmk8850_lcm_therm";
						qcom,ratiometric;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,adc-tm-type = <0x1>;
						qcom,adc5-gen4;
					};
				};
				lenovo_13: qcom,power-telemetry-device {
					compatible = "qcom,power-telemetry";
					status = "okay";
					interrupts = <0x0 0xa2 0x1 0x1 0x0 0xa1 0x1 0x1>;
					nvmem = <&lenovo_2 &lenovo_3 &lenovo_4>;
					nvmem-names = "qpt-config-sdam", "qpt-frac-sdam", "qpt-data-sdam";
					#powerzone-cells = <0x1>;
					power-domains = <&CLUSTER_PD2>;
				};
				lenovo_5a: qcom,voltage-adj-device {
					compatible = "qcom,vadj";
				};
				btl {
					compatible = "qcom,btl";
					nvmem = <&lenovo_5>;
					nvmem-names = "btl-sdam";
				};
				qcom,power-telemetry-data-share-device {
					compatible = "qcom,power-telemetry-data-share";
				};
			};
			pmh0101@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x1 0x0>;
				#address-cells = <0x1>;
				#size-cells = "", "", "", "";
				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0101";
				};
				lenovo_1e: pmh0101-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = "", "", "\n";
					interrupts = <0x1 0xa 0x0 0x3>;
					#thermal-sensor-cells = "", "", "", "";
					io-channels = <&lenovo_6 0x103>;
					io-channel-names = "thermal";
				};
				lenovo_5b: pinctrl@8800 {
					compatible = "qcom,pmh0101-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x2>;
					interrupt-controller;
					#interrupt-cells = <0x2>;
					lenovo_5c: qtm-therm-default-state {
						pins = "gpio2";
						function = "normal";
						bias-high-impedance;
					};
					lenovo_1: pa-therm2-default-state {
						pins = "gpio3";
						function = "normal";
						bias-high-impedance;
					};
					lenovo_5d: cam-sensor-1p8-rst0-active-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x2>;
						input-disable;
						output-enable;
						output-high;
						power-source = "", "", "", "";
					};
					lenovo_5e: cam-sensor-1p8-rst0-suspend-state {
						pins = "gpio4";
						function = "normal";
						qcom,drive-strength = <0x2>;
						input-disable;
						output-enable;
						output-low;
					};
					lenovo_5f: pmh0101-bidir-lvl-shifter1-state {
						pins = "gpio11", "gpio12";
						function = "normal";
						bias-high-impedance;
					};
					lenovo_60: pmh0101-bidir-lvl-shifter2-state {
						pins = "gpio13", "gpio14";
						function = "normal";
						bias-high-impedance;
					};
					lenovo_61: pmh0101-bidir-lvl-shifter3-state {
						pins = "gpio15", "gpio16";
						function = "normal";
						bias-high-impedance;
					};
					lenovo_62: pmh0101-bidir-lvl-shifter4-state {
						pins = "gpio17", "gpio18";
						function = "normal";
						bias-high-impedance;
					};
					flash_led_ntc {
						lenovo_38: flash_led_ntc_default {
							pins = "gpio1";
							bias-high-impedance;
						};
					};
					quiet_therm {
						lenovo_39: quiet_therm_default {
							pins = "gpio9";
							bias-high-impedance;
						};
					};
					fast_chg_therm {
						lenovo_3a: fast_chg_therm_default {
							pins = "gpio2";
							bias-high-impedance;
						};
					};
				};
				lenovo_63: led-controller {
					compatible = "qcom,pmh0101-pwm", "qcom,pm8350c-pwm";
					#address-cells = <0x1>;
					#size-cells = "", "", "", "";
					#pwm-cells = <0x2>;
					nvmem = <&lenovo_7 &lenovo_8>;
					nvmem-names = "lpg_chan_sdam", "lut_sdam";
					led@1 {
						reg = <0x1>;
						color = <0x1>;
						label = "red";
					};
					led@2 {
						reg = <0x2>;
						color = <0x2>;
						label = "green";
					};
					led@3 {
						reg = <0x3>;
						color = <0x3>;
						label = "blue";
					};
				};
				lenovo_19: bcl@4700 {
					compatible = "qcom,pmh0101-bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x1 0x47 0x0 0x0 0x1 0x47 0x1 0x0 0x1 0x47 0x2 0x0>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x1>;
				};
				lenovo_64: led-controller@ee00 {
					compatible = "qcom,pmh0101-flash-led", "qcom,spmi-flash-led";
					reg = <0xee00>;
					lenovo_65: led-0 {
						function = "flash";
						function-enumerator = "", "", "", "";
						color = <0x6>;
						led-sources = <0x1 0x4>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
					};
					lenovo_66: led-1 {
						function = "flash";
						function-enumerator = <0x1>;
						color = "", "", "", "";
						led-sources = <0x2 0x3>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
					};
					lenovo_67: led-2 {
						function = "flash";
						function-enumerator = <0x2>;
						color = <0x4>;
						led-sources = <0x1 0x2 0x3 0x4>;
						led-max-microamp = <0x7a120>;
						flash-max-microamp = <0x1e8480>;
						flash-max-timeout-us = <0x138800>;
					};
				};
			};
			lenovo_68: pmh0110@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x3 0x0>;
				#address-cells = <0x1>;
				#size-cells = "", "", "", "";
				pmic-ecid@100 {
					compatible = "qcom,pmic-ecid";
					reg = <0x100>;
					qcom,pmic-name = "pmh0110_d";
				};
				lenovo_1f: pmh0110-d-temp-alarm@a00 {
