			qcom,mi2s-clk-attribute = <0x1 0x1 0x1 0x1 0x1 0x1 0x1>;
			qcom,tdm-clk-attribute = <0x1 0x1 0x1 0x1 0x1 0x1 0x1>;
			qcom,tdm-max-slots = <0x8>;
			qcom,ext-disp-audio-rx = <0x1>;
			qcom,wcd-disabled = <0x1>;
			qcom,wcn-bt = <0x1>;
			qcom,mi2s-tdm-is-hw-vote-needed = <0x1 0x1 0x1 0x1 0x1 0x1 0x1>;
			qcom,msm-mi2s-master = <0x1 0x1 0x1 0x1 0x1 0x1 0x1>;
			qcom,model = "canoe-qrd-snd-card";
			port@0 {
				lenovo_314: endpoint {
					remote-endpoint = <&lenovo_b6>;
				};
			};
			port@1 {
				lenovo_315: endpoint {
					remote-endpoint = <&lenovo_b7>;
				};
			};
		};
	};
	lenovo_362: fragment@228 {
		target = <&qupv3_se4_i2c>;
		__overlay__ {
			aw882xx_smartpa@34 {
				status = "okay";
				aw-cali-mode = "none";
				aw-re-max = <0x7530>;
				aw-re-min = <0xfa0>;
				rename-flag = <0x1>;
				sound-channel = "", "", "", "";
				sync-load = <0x1>;
				pa-vddio-supply = <&L1G>;
				pa-dvdd-supply = <&L12B>;
				reset-gpio = <&tlmm 0x72 0x0>;
				reg = <0x34>;
				compatible = "awinic,aw882xx_smartpa";
			};
			aw882xx_smartpa@37 {
				status = "okay";
