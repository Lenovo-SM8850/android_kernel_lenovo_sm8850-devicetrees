	snps,usb2-lpm-disable;
};

&{/soc/tlmm-vm-test} {
	tlmm-vm-gpio-list = <&tlmm 0x56 0x0 &tlmm 0x57 0x0 &tlmm 0x61 0x0 &tlmm 0x62 0x0 &tlmm 0x30 0x0 &tlmm 0x31 0x0 &tlmm 0x32 0x0 &tlmm 0x33 0x0 &tlmm 0x9e 0x0 &tlmm 0x42 0x0 &tlmm 0x64 0x0 &tlmm 0x8 0x0 &tlmm 0x9 0x0 &tlmm 0xa 0x0 &tlmm 0xb 0x0 &tlmm 0x58 0x0>;
