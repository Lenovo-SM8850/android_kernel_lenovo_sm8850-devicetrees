// ZUXOS 2.0.12.088 PRC base entry 12 delta over the QTI CanoeP v2 techpack set.

/delete-node/ &{/ddr-regions};
/delete-node/ &{/reserved-memory/hypervisor_extended_heap_region@0xc3dd0000};
/delete-node/ &{/reserved-memory/ramoops-region};
/delete-node/ &{/reserved-memory/reserved_region@80e00000};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmh0110@8/pinctrl@8800/cam-sensor-1p8-rst1-active-state};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmh0110@8/pinctrl@8800/cam-sensor-1p8-rst1-suspend-state};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/pinctrl@b800/alt-sleep-clk-default-state};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/pinctrl@b800/xoagg-therm-default-state};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/vadc@9000/pmh0101_cam_flash_therm};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/vadc@9000/pmh0101_pa_therm1};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/vadc@9000/pmh0101_pa_therm2};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/vadc@9000/pmh0101_skin_therm};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/vadc@9000/pmh0101_wlan_therm};
/delete-node/ &{/soc/arbiter@c400000/spmi@c426000/pmk8850@0/vadc@9000/pmk8850_xoagg_therm};
/delete-node/ &{/soc/funnel@11163000/in-ports};
/delete-node/ &{/soc/qcom,gpu-coresight-cx};
/delete-node/ &{/soc/qcom,gpu-coresight-gx};
/delete-node/ &{/soc/qcom,mdss_dsi_ctrl0@9ac0000/qcom,ctrl-supply-entries/qcom,ctrl-supply-entry@1};
/delete-node/ &{/soc/qcom,mdss_dsi_ctrl1@9ac3000/qcom,ctrl-supply-entries/qcom,ctrl-supply-entry@1};
/delete-node/ &{/soc/qcom,mdss_dsi_phy0@9ac1500/qcom,phy-supply-entries/qcom,phy-supply-entry@1};
/delete-node/ &{/soc/qcom,mdss_dsi_phy1@9ac4500/qcom,phy-supply-entries/qcom,phy-supply-entry@1};
/delete-node/ &{/soc/qfprom@221c8000/debugbus_en@783};
/delete-node/ &{/soc/qfprom@221c8000/gpu_niden_en@783};
/delete-node/ &{/soc/qmi-tmd-devices/modem/modem_bcl_mtpl_dsc};

&{/} {
	mem-offline {
		compatible = "qcom,mem-offline";
		status = "disabled";
		offline-sizes = <0x02 0xc0000000 0x01 0x00>;
		granule = <0x200>;
		qcom,qmp = <&aoss_qmp>;
	};
};

&{/} {
	product_region: product_region {
		build_region = "PRC";
	};
};

&{/reserved-memory} {
	hypervisor_extended_heap_mem: hypervisor_extended_heap_region@80e00000 {
		no-map;
		reg = <0x00 0x80e00000 0x00 0x400000>;
	};
};

&{/reserved-memory} {
	ramoops_mem: ramoops-region@0xc2000000 {
		reg = <0x00 0xc2000000 0x00 0xc0000>;
		no-map;
	};
};

&{/soc/arbiter@c400000/spmi@c426000/pmh0110@3/pinctrl@8800} {
	led_reset_ctrl_default: led_reset_ctrl_default {
		pins = "gpio11";
		function = "normal";
		output-high;
		bias-disable;
		power-source = <0x01>;
		qcom,drive-strength = <0x02>;
	};
};

&{/soc/pmic-glink/ucsi-glink} {
	compatible = "lenovo,dual-port-ucsi-glink-v1", "qcom,ucsi-glink";
	lenovo,analog-audio-switch-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
	connector {
		ports {
			port@1 {
				ucsi_audio_mux0: endpoint {
					remote-endpoint = <&fsa4480_mux0>;
				};
			};
		};
	};
};

&{/soc/pmic-glink/ucsi-glink} {
	connector1 {
		ports {
			port@1 {
				ucsi_audio_mux1: endpoint {
					remote-endpoint = <&fsa4480_mux1>;
				};
			};
		};
	};
};

&{/soc/qcom,qupv3_1_geni_se@ac0000/i2c@a94000} {
	aw22xxx_led@6a {
		compatible = "awinic,aw22xxx_led";
		reg = <0x6a>;
		pinctrl-names = "led_reset_ctrl_default";
		pinctrl-0 = <&led_reset_ctrl_default>;
		irq-gpio = <&tlmm 0x3 0x0>;
		status = "okay";
		aw22xxx,led {
			aw22xxx,name = "aw22xxx_led";
			aw22xxx,imax = <0x03>;
			aw22xxx,brightness = <0x80>;
			aw22xxx,max_brightness = <0xff>;
		};
	};
};

&{/soc/qcom,qupv3_1_geni_se@ac0000/i2c@a94000} {
	fsa4480: fsa4480_i2c@43 {
		compatible = "qcom,fsa4480-i2c";
		reg = <0x43>;
		mode-switch;
		port {
			fsa4480_mux0: endpoint {
				remote-endpoint = <&ucsi_audio_mux0>;
			};
		};
	};
};

&{/soc/qcom,qupv3_1_geni_se@ac0000/i2c@a94000} {
	fsa4480_sub: fsa4480_sub_i2c@42 {
		compatible = "qcom,fsa4480-sub-i2c";
		reg = <0x42>;
		mode-switch;
		port {
			fsa4480_mux1: endpoint {
				remote-endpoint = <&ucsi_audio_mux1>;
			};
		};
	};
};

&{/soc/rsc@18900000/drv@2} {
	rpmh-regulator-l16b-e0 {
		compatible = "qcom,rpmh-vrm-regulator";
		qcom,resource-name = "L16B_E0";
		qcom,regulator-type = "pmic7-ldo";
		qcom,supported-modes = <0x02 0x03>;
		qcom,mode-threshold-currents = <0x00 0x7530>;
		L16B: L16B_E0: pmh0101_l16: regulator-pmh0101-l16 {
			regulator-name = "pmh0101_l16";
			qcom,set = <0x03>;
			regulator-min-microvolt = <0x2c4fc0>;
			regulator-max-microvolt = <0x2c4fc0>;
			qcom,init-voltage = <0x2c4fc0>;
			qcom,init-mode = <0x03>;
		};
	};
};

&{/chosen} {
	bootargs = "android_arch_task_struct_size=512 loglevel=6 log_buf_len=512K cpufreq.default_governor=performance sysctl.kernel.sched_pelt_multiplier=4 no-steal-acc kpti=0 swiotlb=0 loop.max_part=7 irqaffinity=0-1 fw_devlink.strict=1 pcie_ports=compat pci-msm-drv.pcie_sm_regs=0x1D07000,0x1040,0x1048,0x3000,0x1 kasan=off rcupdate.rcu_expedited=1 rcu_nocbs=0-7 cgroup_disable=pressure printk.console_no_auto_verbose=1 sysctl.kernel.panic_on_rcu_stall=1 ftrace_dump_on_oops disable_dma32=on restrict_cma_redirect=false";
};

&{/soc/apps-smmu@15000000/nsp_qtb@7d3000} {
