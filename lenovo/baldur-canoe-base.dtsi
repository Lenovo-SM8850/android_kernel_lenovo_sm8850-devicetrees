&{/soc/pinctrl@f000000} {
	qcom,gpios-reserved = <0x26 0x27 0x4a 0x77 0x78 0x90 0x91 0x92 0x93>;
};

&{/soc/pinctrl@f000000/sdc2_off/sd-cd} {
	bias-disable;
	/delete-property/ bias-pull-up;
};

&{/soc/pinctrl@f000000/sdc2_on/clk} {
	drive-strength = <0x06>;
};

&{/soc/pinctrl@f000000/sdc2_on/cmd} {
	drive-strength = <0x06>;
};

&{/soc/pinctrl@f000000/sdc2_on/data} {
	drive-strength = <0x06>;
};

&{/soc/pmic-glink/battery-charger} {
	compatible = "lenovo,dual-bank-battery-charger-v1", "qcom,battery-charger";
};

&{/soc/qcom,cvp@2400000/cvp_non_secure_cb_group} {
	qcom,iommu-faults = "non-fatal";
};

&{/soc/qcom,dp_display@9ad2000} {
	qcom,dp-aux-switch = <&fsa4480>;
};

&{/soc/qcom,kgsl-3d0@3d00000} {
	nvmem-cell-names = "gpu_debug_bus_bin\0speed_bin";
	nvmem-cells = <&gpu_debug_bus_bin &gpu_speed_bin>;
	/delete-property/ qcom,gpu-qdss-stm;
	reg = <0x00 0x3d00000 0x00 0x40000 0x00 0x3d50000 0x00 0x10000 0x00 0x3d61000 0x00 0x3000 0x00 0x3d9e000 0x00 0x2000 0x00 0x11100000 0x00 0x80000>;
	reg-names = "kgsl_3d0_reg_memory\0rscc\0cx_dbgc\0cx_misc\0qdss_gfx";
};

&{/soc/qcom,mdss_dsi_ctrl0@9ac0000} {
	/delete-property/ vdda-1p2-parent-supply;
};

&{/soc/qcom,mdss_dsi_ctrl1@9ac3000} {
	/delete-property/ vdda-1p2-parent-supply;
};

&{/soc/qcom,mdss_dsi_phy0@9ac1500} {
	/delete-property/ vdda-0p9-parent-supply;
};

&{/soc/qcom,mdss_dsi_phy1@9ac4500} {
	/delete-property/ vdda-0p9-parent-supply;
};

&{/soc/qcom,qupv3_1_geni_se@ac0000/i2c@a94000} {
	status = "okay";
};

&{/soc/qcom,qupv3_2_geni_se@8c0000/i2c@880000} {
	dmas = <&gpi_dma2 0x0 0x0 0x3 0x400 0x0 &gpi_dma2 0x1 0x0 0x3 0x400 0x0>;
};

&{/soc/qcom,qupv3_3_geni_se@19c0000/i3c-master@1984000} {
	clock-names = "se-clk";
	clocks = <&gcc 0x74>;
	dmas = <&gpi_dma3 0x0 0x1 0x4 0x40 0x0 &gpi_dma3 0x1 0x1 0x4 0x40 0x0>;
	/delete-property/ interrupts;
	interrupts-extended = <&intc 0x0 0x247 0x4>;
};

&{/soc/qcom,qupv3_3_geni_se@19c0000/spi@1990000} {
	/delete-property/ qcom,ipc-size;
};

&{/soc/qcom,qupv3_4_geni_se@1ac0000/i3c-master@1a80000} {
	dmas = <&gpi_dma4 0x0 0x0 0x4 0x40 0x0 &gpi_dma4 0x1 0x0 0x4 0x40 0x0>;
};

&{/soc/qcom,qupv3_4_geni_se@1ac0000/spi@1a80000} {
	spi-max-frequency = <0x989680>;
};

&{/soc/qcom_ramoops} {
	console-size = <0x40000>;
	ecc-size = <0x10>;
	max-reason = <0x04>;
	memory-region = <&ramoops_mem>;
	pmsg-size = <0x40000>;
	record-size = <0x10000>;
};

&{/soc/remoteproc-soccp@a3380000} {
	/delete-property/ interconnect-names;
	/delete-property/ interconnects;
};

&{/soc/rsc@18900000/drv@2/rpmh-regulator-l18b-e0/regulator-pmh0101-l18} {
	regulator-max-microvolt = <0x13e5c0>;
};

&{/soc/rsc@18900000/drv@2/rpmh-regulator-l4f-e0} {
	proxy-supply = <&L4F>;
};

&{/soc/rsc@18900000/drv@2/rpmh-regulator-l4f-e0/regulator-pmh0110-f-l4} {
