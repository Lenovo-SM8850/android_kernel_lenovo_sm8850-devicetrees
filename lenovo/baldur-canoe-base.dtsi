// The current DTBO replaces these endpoint handles without rewriting all
// inherited references. Preserve the stock stale values for merged equivalence.
&{/soc/pmic-glink/ucsi-glink/connector/ports/port@1/endpoint} { phandle = <0x2cc>; };
&{/soc/pmic-glink/ucsi-glink/connector1/ports/port@1/endpoint} { phandle = <0x2cb>; };
