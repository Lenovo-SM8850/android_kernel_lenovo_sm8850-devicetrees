// SPDX-License-Identifier: GPL-2.0
// Lenovo TB324ZC: gen6 Canoe v2 base and QTI techpacks.
// Reuse shared Canoe techpack includes; Wuji board data is defined below.
/dts-v1/;
#include "../qcom/canoe-v2.dtsi"
#include "../qcom/canoe-pmic-overlay.dtsi"
#include "canoe-base-techpacks-before-ipa.dtsi"
// Data/canoe-ipa.dts: modem/AP IPA init and SMMU context banks.
#include <dt-bindings/clock/qcom,rpmh.h>
#include "../qcom/data/canoe-ipa.dtsi"
#include "canoe-base-techpacks-after-ipa.dtsi"
&ipa_hw {
	// Preserve the stock board's SVS2 vote and uC HOLB monitoring.
	qcom,svs2 = <0 0 0 1300000 0 76800>;
	qcom,ipa-uc-holb-monitor;
};

/ {
	lenovo,charger-key-coordination;
	lenovo,amplifier-supply-control;
	lenovo,cellular-hardware-info;
	lenovo,front-eeprom-fuse;
	lenovo,usb-c-accessory-mux;
	model = "Qualcomm Technologies, Inc. Canoe v2 SoC";
	compatible = "lenovo,wuji", "qcom,canoe";
	qcom,msm-id = <0x294 0x20000>;
	qcom,board-id = <0 0>;
};
